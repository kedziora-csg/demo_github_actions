# Results land wherever BENCH_RESULTS_ROOT points, which defaults to the
# directory the job was submitted from -- so running `./submit ...` here leaves
# a directory per experiment.  Ignored rather than moved: where results go is
# the operator's choice (site.sh, or --results-dir), and pinning it in the
# repository would take that choice away.
/*/job.env
/*/*/job.env
/*/*/job.json
/*/*/job.pbs
/*/*/job.log
/*/*/results.jsonl
/*/*/run.meta
/*/*/app.yaml
/*/*/topology.json
/*/*/modules.txt
/*/*/env.txt
/*/*/launcher.sh
/*/*/apptainer-launch-*.sh
/*/*/ldd_*.txt
/*/*/placement_*.out
/*/*/run_*/
