#!/bin/bash
#PBS -N app_bench
#PBS -A PBS_ACCOUNT_UNSET
# ^ deliberately not a real allocation: pass your own with
#       qsub -A <PROJECT> ...
#   qsub rejects the placeholder rather than silently charging someone else.
#PBS -j oe
#PBS -q main
#PBS -l walltime=00:30:00
#PBS -l select=2:ncpus=128:mpiprocs=128:ompthreads=1

#-------------------------------------------------------------------------------
# App_benchmarker_derecho.pbs -- benchmark ONE image by hand.
#
# Was Placement_derecho_opt.pbs, which had stopped being a placement script some
# time ago: it swept images, swept decompositions, verified placement AND timed
# an application.  The sweep now lives in bench/, so what is left here is the
# hand-qsub entry point -- directives, the site profile, hand over.
#
# There are two ways in, and they run the same code:
#
#     bench/submit <experiment> --account <PROJECT>     the matrix
#     qsub -A <PROJECT> -v APP=hpcg <this file>         one image, right now
#
# Use bench/submit for anything you intend to compare.  Use this when you are
# iterating -- a new image, a new contract, a fix you want to see fail fast --
# and do not want to write an experiment file first.
#
# WHICH QUESTION THIS ANSWERS, AND WHICH IT DOES NOT
#
# This one is "which configuration is fastest?"  It is a consumer of images that
# have already been certified.
#
# Placement_derecho.pbs answers a different question -- "does this image work on
# this host?", i.e. does the Cray MPICH ABI shim displace the container's
# libmpi, does the binding come out clean.  That is an image-certification test
# and it belongs to the factory.  Different question, different audience,
# different cadence: they are deliberately not merged, and they already share
# everything worth sharing through libexec/.
#
# USAGE
#
#   Placement only (verify the layouts, no workload):
#       qsub -A <PROJECT> App_benchmarker_derecho.pbs
#
#   Benchmark an application that ships a contract in the image:
#       qsub -A <PROJECT> -v APP=hpcg App_benchmarker_derecho.pbs
#       qsub -A <PROJECT> -v APP=osu,OSU_BENCHMARK=osu_allreduce ...
#
#   Benchmark a bare executable (no contract; you get wall time and placement):
#       qsub -A <PROJECT> -v APP=/glade/work/$USER/bin/wrf.exe ...
#
#   Iterate on a contract without rebuilding the image (results are marked):
#       qsub -A <PROJECT> -v APP=hpcg,BENCH_APP_DIR=/glade/work/$USER/app.d ...
#
#   Pick the image, and repeat each cell:
#       qsub -A <PROJECT> -v APP=hpcg,container_img=/path/to/x.sif,BENCH_REPEATS=3 ...
#
# With no job.env to read, the runner derives its three cells from the topology
# it probes on the node -- one rank per core, one per L3, one per NUMA domain.
# On Derecho that is 128x1, 16x8 and 8x16; elsewhere it is the same three ideas,
# correctly sized.  bench/runner.sh documents everything the job leaves behind.
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# Find and source the site profile.
#
# Inline here rather than in libexec/, because libexec is one of the things the
# profile locates.
#
# Looked for in three places, first one found wins:
#   1. $BENCH_SITE_CONF                                    named outright
#   2. ${XDG_CONFIG_HOME:-$HOME/.config}/hpcdev/cluster.sh your own copy
#   3. sites/*/<cluster>/cluster.sh, walking up from $PBS_O_WORKDIR
#
# 3 keeps a submit-from-the-checkout workflow working with no setup at all.
# 2 is what lets this script be submitted from any directory on the machine.
#
# PBS copies this script into its own spool, so $0 does not point at the
# checkout; $PBS_O_WORKDIR is the only reliable record of where you were.
#
# A job generated by bench/submit does not do this search at all -- it names the
# profile outright, because a job generated from one checkout must be driven by
# that checkout even if the operator also has a ~/.config copy pointing
# elsewhere.  Here, where a person typed the qsub, the search is the point.
#-------------------------------------------------------------------------------
_profile_cluster () { ( . "$1" >/dev/null 2>&1; printf '%s' "${BENCH_CLUSTER:-}" ); }

_find_cluster_conf () {
    local from="${1:-$(pwd)}" cluster="${2:-derecho}" d p

    [ -n "${BENCH_SITE_CONF:-}" ] && [ -f "${BENCH_SITE_CONF}" ] && {
        printf '%s' "${BENCH_SITE_CONF}"; return 0; }

    # A ~/.config copy holds ONE cluster and its path does not say which, so it
    # answers only for the cluster being asked for.  Otherwise the search falls
    # through to the checkout, which has a profile per machine.  Without this a
    # Derecho copy answers a Casper job and the run is silently wrong: the core
    # count, the bind list and the host-MPI recipe would all be the other
    # machine's, and nothing in the results would say so.
    d="${XDG_CONFIG_HOME:-${HOME}/.config}/hpcdev/cluster.sh"
    [ -f "${d}" ] && [ "$(_profile_cluster "${d}")" = "${cluster}" ] && {
        printf '%s' "${d}"; return 0; }

    d="$(cd "${from}" 2>/dev/null && pwd)" || return 1
    while [ -n "${d}" ] && [ "${d}" != "/" ]; do
        # Globbed over the site level: a job names its cluster, not its site.
        for p in "${d}"/sites/*/"${cluster}"/cluster.sh; do
            [ -f "${p}" ] && { printf '%s' "${p}"; return 0; }
        done
        d="$(dirname "${d}")"
    done
    return 1
}

_site_conf="$(_find_cluster_conf "${PBS_O_WORKDIR:-$(pwd)}" "${BENCH_CLUSTER:-derecho}")"
if [ -z "${_site_conf}" ]; then
    echo "cannot find a cluster profile for '${BENCH_CLUSTER:-derecho}'." >&2
    echo "  looked for: \$BENCH_SITE_CONF, \${XDG_CONFIG_HOME:-\$HOME/.config}/hpcdev/cluster.sh," >&2
    echo "              and sites/*/<cluster>/cluster.sh above ${PBS_O_WORKDIR:-$(pwd)}" >&2
    echo "  to submit from outside the checkout, copy" >&2
    echo "  containers/deploy/sites/ncar/derecho/cluster.sh to ~/.config/hpcdev/" >&2
    echo "  as cluster.sh, and set" >&2
    echo "  NCAR_HPC_ROOT in it." >&2
    exit 1
fi
. "${_site_conf}" || { echo "cannot source ${_site_conf}" >&2; exit 1; }
[ -d "${NCAR_HPC_ROOT:-}/libexec" ] || {
    echo "${_site_conf} does not point NCAR_HPC_ROOT at a checkout with libexec/" >&2
    echo "  NCAR_HPC_ROOT=${NCAR_HPC_ROOT:-<unset>}" >&2
    echo "  set it near the top of that file" >&2
    exit 1
}
[ -x "${BENCH_ROOT:-}/runner.sh" ] || {
    echo "${_site_conf} does not point BENCH_ROOT at containers/deploy/bench" >&2
    echo "  BENCH_ROOT=${BENCH_ROOT:-<unset>}" >&2
    exit 1
}

bench_site_modules || { echo "site module bootstrap failed" >&2; exit 1; }

# Exported because the next line is an exec: exported VARIABLES cross an exec,
# shell FUNCTIONS do not.  The runner re-sources this file to recover the
# bench_site_* lookups, and naming it here means it recovers the one this job
# actually found rather than searching again from a different directory.
export BENCH_SITE_CONF="${_site_conf}"

exec "${BENCH_ROOT}/runner.sh"
