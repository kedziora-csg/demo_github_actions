#!/bin/bash
#PBS -N placement_opt
#PBS -A PBS_ACCOUNT_UNSET
# ^ deliberately not a real allocation: pass your own with
#       qsub -A <PROJECT> ...
#   (or use ../submit_placement_matrix.sh --account <PROJECT>).
#   qsub rejects the placeholder rather than silently charging someone else.
#PBS -j oe
#PBS -q main
#PBS -l walltime=00:30:00
#PBS -l select=2:ncpus=128:mpiprocs=128:ompthreads=1

#-------------------------------------------------------------------------------
# Rank/thread decomposition sweep for Derecho, as a template for real workloads.
#
# Runs the same job three ways, holding everything else fixed:
#
#   name     ranks/node  threads  aligns each rank to
#   -------  ----------  -------  ------------------------------------------
#   pureMPI     128         1     one core           (the honest baseline)
#   ccd          16         8     one CCD / L3       (32 MB shared, no fabric
#                                                     crossing inside a rank)
#   numa          8        16     one NUMA domain    (but straddles 2 CCDs)
#
# All three satisfy ranks x threads == 128.  That constraint is not cosmetic:
# --cpu-bind depth packs consecutively from core 0, so a smaller product does
# not merely idle cores, it crowds every rank onto the low chiplets.
#
# Derecho CPU nodes (measured, jobs 7024910/7024919):
#   2 x EPYC 7763 Milan -- 128 physical cores, SMT ON => 256 logical CPUs
#   8 NUMA domains (NPS4, 16 cores each) | 16 CCDs (8 cores each, 32 MB L3)
# Keeping ranks x threads == 128 stays on physical cores 0-127; the SMT siblings
# at 128-255 are deliberately left alone (they share FPU/vector units, which
# usually costs more than it gains for FP-bound codes).
#
# USAGE
#   Placement only (verify the layouts, no workload):
#       qsub Placement_derecho_opt.pbs
#
#   Benchmark an application that ships a contract in the image:
#       qsub -v APP=hpcg Placement_derecho_opt.pbs
#       qsub -v APP=osu,OSU_BENCHMARK=osu_allreduce ...
#
#   Benchmark a bare executable (no contract; you get wall time and placement):
#       qsub -v APP=/glade/work/$USER/bin/wrf.exe ...
#
#   Iterate on a contract without rebuilding the image (results are marked):
#       qsub -v APP=hpcg,BENCH_APP_DIR=/glade/work/$USER/app.d ...
#
# Each configuration prints a placement report first, then names any pathology
# found in it, then the timed workload.  Placement is therefore never a
# confounder in the timings.
#
# WHAT THE JOB LEAVES BEHIND
#
# RESULTS_DIR is self-contained: reading it never requires this script, the job
# log, or knowing what was submitted.
#
#     results.jsonl            one JSON object per measured cell
#     run.meta                 the job-level `# key value` header
#     topology.json            the node topology this job probed
#     modules.txt env.txt      the environment the run actually had
#     launcher.sh              the generated Apptainer launcher, verbatim
#     ldd_*_host.txt           linkage through the launcher, after the host
#                              libraries displace the container's
#     placement_<cfg>.out      report_placement output, provenance header first
#     run_<cfg>/               the app's own cwd: inputs, app.out, metrics.kv
#
# Stdout carries only the narrative: each cell's geometry and placement verdict,
# its figure of merit, and anything that aborted it.  BENCH_VERBOSE=1 also echoes
# the captured files as they are written -- for bringing up a new site or a new
# app, where you are watching the job rather than reading it afterwards.
#
# The verdict is DERIVED, not asserted against a per-configuration expectation:
# the checker reads the run's own OMP_PLACES out of the report and crosses it
# with the topology probed at the top of this job.  A configuration is a name, a
# rank count and a thread count -- nothing else.
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# Find and source the site profile.
#
# Inline in each PBS script rather than in libexec/, because libexec is one of
# the things the profile locates.
#
# Looked for in three places, first one found wins:
#   1. $BENCH_SITE_CONF                                    named outright
#   2. ${XDG_CONFIG_HOME:-$HOME/.config}/hpcdev/site.sh    your own copy
#   3. sites/<site>/site.sh, walking up from $PBS_O_WORKDIR
#
# 3 keeps a submit-from-the-checkout workflow working with no setup at all.
# 2 is what lets this script be submitted from any directory on the machine.
#
# PBS copies this script into its own spool, so $0 does not point at the
# checkout; $PBS_O_WORKDIR is the only reliable record of where you were.
#-------------------------------------------------------------------------------
_find_site_conf () {
    local from="${1:-$(pwd)}" site="${2:-derecho}" d

    [ -n "${BENCH_SITE_CONF:-}" ] && [ -f "${BENCH_SITE_CONF}" ] && {
        printf '%s' "${BENCH_SITE_CONF}"; return 0; }

    d="${XDG_CONFIG_HOME:-${HOME}/.config}/hpcdev/site.sh"
    [ -f "${d}" ] && { printf '%s' "${d}"; return 0; }

    d="$(cd "${from}" 2>/dev/null && pwd)" || return 1
    while [ -n "${d}" ] && [ "${d}" != "/" ]; do
        [ -f "${d}/sites/${site}/site.sh" ] && {
            printf '%s' "${d}/sites/${site}/site.sh"; return 0; }
        d="$(dirname "${d}")"
    done
    return 1
}

_site_conf="$(_find_site_conf "${PBS_O_WORKDIR:-$(pwd)}" "${BENCH_SITE:-derecho}")"
if [ -z "${_site_conf}" ]; then
    echo "cannot find a site profile for '${BENCH_SITE:-derecho}'." >&2
    echo "  looked for: \$BENCH_SITE_CONF, \${XDG_CONFIG_HOME:-\$HOME/.config}/hpcdev/site.sh," >&2
    echo "              and sites/<site>/site.sh above ${PBS_O_WORKDIR:-$(pwd)}" >&2
    echo "  to submit from outside the checkout, copy" >&2
    echo "  containers/deploy/sites/derecho/site.sh to ~/.config/hpcdev/ and set" >&2
    echo "  NCAR_HPC_ROOT in it." >&2
    exit 1
fi
. "${_site_conf}" || { echo "cannot source ${_site_conf}" >&2; exit 1; }
[ -d "${NCAR_HPC_ROOT:-}/libexec" ] || {
    echo "${_site_conf} does not point NCAR_HPC_ROOT at a checkout with libexec/" >&2
    echo "  NCAR_HPC_ROOT=${NCAR_HPC_ROOT:-<unset>}" >&2
    echo "  set it near the top of that file" >&2
    exit 1
}

bench_site_modules || { echo "site module bootstrap failed" >&2; exit 1; }

#-------------------------------------------------------------------------------
# Knobs
#-------------------------------------------------------------------------------
# APP is an application NAME resolved under /container/app.d/, or a path to a
# bare executable.  This script knows nothing else about it -- what to write
# before the run, how to launch it and how to read its output all come from the
# app's own contract.  See scripts/app.d/README.md.
APP="${APP:-}"
APP_ARGS="${APP_ARGS:-}"             # appended to the argv; the launch hook is preferred

# Handed to every hook.  BENCH_SCALE names an app-defined size class and
# BENCH_TARGET_SECONDS how long a cell should aim to take; an app that cannot
# honour either is free to ignore them.
BENCH_SCALE="${BENCH_SCALE:-node}"
BENCH_TARGET_SECONDS="${BENCH_TARGET_SECONDS:-60}"
NNODES="$(sort -u $PBS_NODEFILE | wc -l | tr -d '[:space:]')"


# Artifacts land in the site's results root unless told otherwise;
# submit_placement_matrix.sh passes this explicitly so each image gets its own.
RESULTS_DIR="${RESULTS_DIR:-${BENCH_RESULTS_ROOT}}"

nodes_list="$(sort -u $PBS_NODEFILE | tr '\n' ' ' | sed 's/ *$//')"
echo
[ -n "${APP}" ] || echo "app       <none: placement verification only>"
echo "nodes     ${NNODES}  (${nodes_list//.hpc.ucar.edu/})"
echo "results   ${RESULTS_DIR}"

# Create the per-image output directory before generating helper scripts.  The
# launcher must live there too: later this script cd's into RESULTS_DIR, and a
# relative ./apptainer-launch-* path would stop resolving.
mkdir -p "${RESULTS_DIR}" \
    || { echo "cannot create RESULTS_DIR=${RESULTS_DIR}"; exit 1; }

#-------------------------------------------------------------------------------
# Launcher.  Every rank execs apptainer with the host MPI (Cray MPICH or
# OpenMPI) swapped in.  The MPI-family dialect and the host-vs-container
# agreement get validated in Placement_derecho.pbs; this script only consumes
# already-correct settings via the shared helper.
#
# lib-abi-mpich, NOT lib: only the ABI directory exports a libmpi.so.12 that can
# displace the container's own.  Get this wrong and every rank silently
# singleton-initialises -- N serial programs that look like a running job.
#-------------------------------------------------------------------------------
# Every library up front, before anything calls into them: make_apptainer_launcher
# routes its progress chatter through vecho, which provenance.sh owns.
#
#   make_apptainer_launcher.sh  the host-MPI launcher and the mpiexec dialects
#   check_placement.sh          placement_summary / _verdict / _rules_fired
#   results.sh                  the results.jsonl record; pulls in provenance.sh
#                               for emit_provenance, capture_run_context, the
#                               sub-second clock and the BENCH_VERBOSE helpers
#   app_contract.sh             app.yaml + the prepare/launch/extract hooks
for lib in make_apptainer_launcher.sh check_placement.sh results.sh app_contract.sh; do
    . "${NCAR_HPC_ROOT}/libexec/${lib}" \
        || { echo "cannot source ${NCAR_HPC_ROOT}/libexec/${lib}" >&2; exit 1; }
done

# leap because openSUSE Leap 15 is built from the same SLE 15 SP6 sources as
# Derecho's host OS; oneapi because intel is the site default compiler family.
export container_img="${container_img:-${BENCH_IMAGE_DIR}/leap-oneapi-mpich.sif}"

# Family is sniffed from the image name unless container_mpi is set explicitly.
comp_family="$(_launcher_sniff_compiler "${container_img}")"
mpi_family="${container_mpi:-$(_launcher_sniff_family "${container_img}")}"
echo "image     $(basename ${container_img})  (compiler=${comp_family} mpi=${mpi_family})"
load_host_modules "${comp_family}" "${mpi_family}" \
    || exit 1

launcher="${RESULTS_DIR}/apptainer-launch-${NCAR_HOST}-${mpi_family}.sh"
make_apptainer_launcher "${launcher}" "${container_img}" "${mpi_family}" \
    || exit 1

REPORT_EXE="${REPORT_EXE:-/container/bin/report_placement}"

# All output lands in its own directory, so parallel jobs (one per image, see
# submit_placement_matrix.sh) cannot collide over report files, timings.txt, or
# the generated launcher.
cd "${RESULTS_DIR}" \
    || { echo "cannot use RESULTS_DIR=${RESULTS_DIR}"; exit 1; }

# Probe this node's topology once, into the results directory.  Every threshold
# the placement rules use -- threads per core, the minimum L3 / NUMA / socket
# groups a rank of N cores can occupy -- is derived from this file, and the
# checker picks it up from the directory each report lives in.  It is also the
# only record of what the run actually ran on: without it a results directory
# cannot say whether it came off a Milan node or something else.
probe_topology "${RESULTS_DIR}/topology.json" \
    || echo "topology probe failed; falling back to built-in Derecho constants"
vshow "${RESULTS_DIR}/topology.json" "node topology"

# Everything else that describes the run rather than measuring it.  These are
# written once per job because none of them change between cells.
capture_run_context "${RESULTS_DIR}" "${launcher}"

# Full linkage on disk; one line on stdout.  `_host` because this is the linkage
# seen THROUGH the launcher, after the host libraries displace the container's;
# Placement_derecho.pbs writes both views and contrasts them.  If libmpi still
# resolves inside /container, every rank singleton-initialises and the job is N
# serial programs that look like a running job.
${launcher} ldd "${REPORT_EXE}" > ldd_report_placement_host.txt 2>&1
if grep -i 'libmpi' ldd_report_placement_host.txt | grep -qv '/container/'; then
    echo "host MPI  $(grep -i 'libmpi' ldd_report_placement_host.txt | head -1 | sed 's/^[[:space:]]*//')"
else
    echo "*** still linking the container's MPI -- see ldd_report_placement_host.txt ***"
    sed 's/^/    /' ldd_report_placement_host.txt
    exit 1
fi
vshow ldd_report_placement_host.txt "ldd ${REPORT_EXE}"

# The digest the .sif was built from.  Empty for an image built before
# libexec/Makefile started stamping it (see pin_image_digest.sh), which is
# recorded as null rather than guessed at.
img_digest="$(sif_digest "${container_img}")"
[ -n "${img_digest}" ] && echo "digest    ${img_digest}"

#-------------------------------------------------------------------------------
# The sweep.  name : ranks-per-node : threads
#
# A configuration states only what it asks for.  What it should GET -- L3, NUMA
# and socket footprint, threads per core -- follows from the probed topology, so
# do not add an expectation field here for the checker to assert against.
#-------------------------------------------------------------------------------
CONFIGS=(
    "pureMPI:128:1"
    "ccd:16:8"
    "numa:8:16"
)

# Two optionts for threads on Derecho, since it has SMT on:
#   This gives one physical core per thread
    export OMP_PROC_BIND=spread     
    export OMP_PLACES=threads
#   This gives two logical cores per thread
    #export OMP_PROC_BIND=close
    #export OMP_PLACES=cores

#-------------------------------------------------------------------------------
# Resolve the application's contract.  Everything this script knows about the
# app comes from here; there is no branch on its name anywhere below.
#-------------------------------------------------------------------------------
app_name="" app_version="" app_override=false
if [ -n "${APP}" ]; then
    app_resolve "${APP}" "${launcher}" "${RESULTS_DIR}" || exit 1
    app_name="${APP_NAME}" app_version="${APP_VERSION}" app_override="${APP_DIR_OVERRIDE}"

    if ! ${launcher} test -x "${APP_BINARY}" 2>/dev/null; then
        echo "app       ${app_name}: ${APP_BINARY} is not executable in this image"
        echo "          build or pull an image that carries it (cd libexec && make derecho-<app>),"
        echo "          or point BENCH_APP_DIR at a contract on a bound filesystem"
        exit 1
    fi

    echo "app       ${app_name}${app_version:+ ${app_version}}  ${APP_BINARY}"
    [ "${app_override}" = true ] && \
        echo "          contract from ${APP_DIR} (override -- results are marked as such)"
    vshow "${RESULTS_DIR}/app.yaml" "app.yaml"

    # The app's own linkage, once per job rather than once per cell -- it cannot
    # change between cells, and the full ldd is a file, not forty lines of log.
    ${launcher} ldd "${APP_BINARY}" > "ldd_$(basename ${APP_BINARY})_host.txt" 2>&1 \
        || echo "note: cannot ldd ${APP_BINARY} (static, or not present)"
    vshow "ldd_$(basename ${APP_BINARY})_host.txt" "ldd ${APP_BINARY}"
fi

# Job-level provenance.  Per-cell facts go into each placement_<cfg>.out header.
emit_provenance run.meta \
    nodes        "${NNODES}" \
    image        "${container_img}" \
    image_digest "${img_digest:-unknown}" \
    compiler     "${comp_family}" \
    mpi_family   "${mpi_family}" \
    app          "${app_name:-none}" \
    app_path     "${APP:-none}" \
    app_args     "${APP_ARGS:-none}" \
    launcher     "${launcher}" \
    report_exe   "${REPORT_EXE}" \
    omp          "OMP_PROC_BIND=${OMP_PROC_BIND:-unset} OMP_PLACES=${OMP_PLACES:-unset}"
vshow run.meta "run.meta"

# The first cell of a job pays the cold read of the .sif off GPFS and the first
# per-rank Apptainer startup.  That cost lands on whichever cell happens to run
# first, so record it rather than let it silently penalise one configuration.
warm=false

for cfg in "${CONFIGS[@]}"; do
    IFS=: read -r name ppn nthreads <<< "${cfg}"
    nranks=$(( NNODES * ppn ))

    # Translate ranks/node + depth into this run's MPI dialect: Cray PALS
    # (mpich/mpich3) spells it -ppn N --cpu-bind core -d D; Open MPI has no
    # -ppn at all and spells the same request --map-by ppr:N:node:pe=D
    # --bind-to core.  See mpi_launch_flags in libexec/make_apptainer_launcher.sh.
    bound_flags="$(mpi_launch_flags "${mpi_family}" ${ppn} ${nthreads} bound)"
    export OMP_NUM_THREADS=${nthreads}

    echo
    echo "=== ${name}: ${ppn} ranks/node x ${nthreads} threads (${nranks} ranks) ==="

    #---------------------------------------------------------------------------
    # Placement first, always.  emit_provenance writes the header; the run
    # appends to it, so the .out explains itself without this script.
    #---------------------------------------------------------------------------
    out="placement_${name}.out"
    emit_provenance "${out}" \
        nodes          "${NNODES}" \
        image          "${container_img}" \
        image_digest   "${img_digest:-unknown}" \
        compiler       "${comp_family}" \
        mpi_family     "${mpi_family}" \
        config         "${name}" \
        ranks          "${nranks}" \
        ranks_per_node "${ppn}" \
        threads        "${nthreads}" \
        omp            "OMP_PROC_BIND=${OMP_PROC_BIND:-unset} OMP_PLACES=${OMP_PLACES:-unset}" \
        launcher       "${launcher}" \
        mpiexec        "mpiexec -n ${nranks} ${bound_flags} ${launcher} ${REPORT_EXE}"

    mpiexec -n ${nranks} ${bound_flags} \
        ${launcher} ${REPORT_EXE} >> "${out}" 2>&1

    placement_summary "${out}"
    place="$(placement_verdict "${out}")"

    [ -n "${APP}" ] || { warm=true; continue; }

    #---------------------------------------------------------------------------
    # The timed run.  Each configuration gets its own private, empty directory:
    # an app may read and write relative to the cwd, so sharing one across cells
    # would have them overwrite each other.  That directory is $BENCH_RUNDIR,
    # and it is the only place a hook may write.
    #---------------------------------------------------------------------------
    rundir="run_${name}"
    rm -rf "${rundir}" && mkdir -p "${rundir}" || exit 1

    app_export_geometry "$(cd "${rundir}" && pwd)" \
        "${name}" "${NNODES}" "${nranks}" "${ppn}" "${nthreads}"

    # The app may DECLINE a geometry it cannot run -- eight ranks when it needs a
    # square number, say.  That is recorded and skipped, not fatal: one refused
    # cell must not cost the other cells their node hours.
    if ! app_prepare "${BENCH_RUNDIR}"; then
        skip="$(tail -3 "${rundir}/prepare.log" 2>/dev/null | tr '\n' ' ')"
        echo "    skipped: ${app_name} declined this geometry${skip:+ -- ${skip}}"
        result_reset
        result_set  site   "${BENCH_SITE}"
        result_set  job_id "${PBS_JOBID:-none}"
        result_set  nodes  "${NNODES}"
        result_str  image.sif "$(basename "${container_img}")"
        result_set  app.name "${app_name}"
        result_str  placement.name "${name}"
        result_set  placement.ranks_per_node "${ppn}"
        result_set  placement.threads "${nthreads}"
        result_set  placement.verdict "${place}"
        result_set  skipped true
        result_str  skip_reason "${skip:-prepare declined this geometry}"
        result_emit results.jsonl
        continue
    fi

    argv="$(app_argv)"

    cd "${rundir}" || exit 1

    # date +%s.%N, not ${SECONDS}: one-second granularity quantises every
    # comparison between short cells.  wall_s is launch-to-exit and INCLUDES
    # per-rank Apptainer startup and the app's own setup phase, which for some
    # apps dwarfs the measured part -- prefer a figure of merit the app reports
    # itself, and treat this as the fallback.
    t0="$(wall_now)"
    mpiexec -n ${nranks} ${bound_flags} \
        ${launcher} ${argv} ${APP_ARGS} > app.out 2>&1
    rc=$?
    wall="$(wall_elapsed "${t0}")"

    # A failed cell is the one case where the log must show the output, because
    # there is nothing else to say about it.
    if [ "${rc}" -ne 0 ]; then
        echo "    exit ${rc} -- last 20 lines of ${rundir}/app.out:"
        tail -20 app.out | sed 's/^/      /'
    fi
    vshow app.out "${rundir}/app.out"
    cd .. || exit 1

    # Figures of merit, as `key=value`, from the app's own extractor.  This
    # script does not know what any of them mean.
    app_extract "${BENCH_RUNDIR}" "${rundir}/metrics.kv"
    vshow "${rundir}/metrics.kv" "${rundir}/metrics.kv"

    #---------------------------------------------------------------------------
    # The record.  One line, appended -- a job killed at walltime keeps every
    # completed cell and loses only the one that was running.
    #---------------------------------------------------------------------------
    result_reset
    result_set  site           "${BENCH_SITE}"
    result_set  job_id         "${PBS_JOBID:-none}"
    result_set  nodes          "${NNODES}"
    result_str  image.sif      "$(basename "${container_img}")"
    result_set  image.digest   "${img_digest}"
    result_set  image.compiler "${comp_family}"
    result_set  image.mpi      "${mpi_family}"
    result_set  app.name       "${app_name}"
    result_str  app.version    "${app_version}"
    result_str  app.scale      "${BENCH_SCALE}"
    result_set  app.app_dir_override "${app_override}"
    result_str  placement.name           "${name}"
    result_set  placement.ranks_per_node "${ppn}"
    result_set  placement.threads        "${nthreads}"
    result_str  placement.mpiexec_flags  "${bound_flags}"
    result_set  placement.verdict        "${place}"
    result_set  placement.omp.OMP_PROC_BIND "${OMP_PROC_BIND:-}"
    result_set  placement.omp.OMP_PLACES    "${OMP_PLACES:-}"
    for fired in $(placement_rules_fired "${out}"); do result_rule "${fired}"; done
    result_set  repeat "${BENCH_REPEAT:-1}"
    result_set  wall_s "${wall}"
    result_set  exit   "${rc}"
    result_set  warm   "${warm}"
    result_metrics_from_file "${rundir}/metrics.kv"
    result_emit results.jsonl

    # One line of narrative: the app's headline number if it declared one, else
    # wall time.  primary_fom is read from the copy of app.yaml that app_resolve
    # left in the results directory.
    fom="$(sed -n 's/^primary_fom:[[:space:]]*//p' app.yaml 2>/dev/null | head -1)"
    score=""
    [ -n "${fom}" ] && score="$(sed -n "s/^${fom}=//p" "${rundir}/metrics.kv" | tail -1)"
    echo "    wall=${wall}s  exit=${rc}${score:+  ${fom}=${score}}  placement=${place}"

    # timings.txt is the old flat format, kept only because
    # submit_placement_matrix.sh --collate still reads it.  Both go away in
    # phase 3, superseded by results.jsonl and bench/collect.
    echo "${name} ${wall} ${rc} ${score:--} ${place}" >> timings.txt
    warm=true
done

#-------------------------------------------------------------------------------
if [ -n "${APP}" ] && [ -f timings.txt ]; then
    echo
    echo "======================================================================="
    echo "SUMMARY  (${app_name:-${APP}})"
    echo "======================================================================="
    printf "  %-10s %8s %6s %12s %10s\n" config wall_s exit "${fom:-metric}" placement
    while read -r n t r g p; do
        printf "  %-10s %8s %6s %12s %10s\n" "$n" "$t" "$r" "${g:--}" "${p:--}"
    done < timings.txt
    echo
    echo "  The app's own figure of merit decides, not wall time: wall_s includes"
    echo "  container startup and the app's setup phase, which for some apps is"
    echo "  most of it.  placement=fail rows never win either way -- a mis-bound"
    echo "  run measures its binding, not the code.  placement=warn is comparable:"
    echo "  the binding is suboptimal but it is the binding that was measured, and"
    echo "  the pathology is named above."
fi

echo
echo "  results.jsonl written to ${RESULTS_DIR}"
echo "  tabulate across jobs with:  containers/deploy/bench/collect <results-root>"
echo
echo "Done at $(date)"
