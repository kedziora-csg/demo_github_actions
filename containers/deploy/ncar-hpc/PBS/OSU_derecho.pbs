#!/bin/bash
#PBS -N OSU_gust
#PBS -A PBS_ACCOUNT_UNSET
# ^ deliberately not a real allocation: pass your own with
#       qsub -A <PROJECT> ...
#   qsub rejects the placeholder rather than silently charging someone else.
#PBS -j oe
#PBS -q main
#PBS -l walltime=00:05:00
#PBS -l select=2:ncpus=64:mpiprocs=4:ompthreads=4:ngpus=4

#-------------------------------------------------------------------------------
# The site profile.  What used to be four hardcoded `module load` lines is now
# one call to bench_site_modules, whose body comes from sites/<site>.yaml.
#
# That change is not cosmetic.  These three scripts said ncarenv/24.12 while
# sites/derecho/site.sh said 25.10, and nothing compared them -- which is what
# a value stated in five places does eventually.
#
# The search is the same three places every entry point here looks, first found
# wins: $BENCH_SITE_CONF, then ~/.config/hpcdev/site.sh, then sites/<site>/site.sh
# walking up from $PBS_O_WORKDIR.  PBS copies this script into its own spool, so
# $0 does not point at the checkout and $PBS_O_WORKDIR is the only reliable
# record of where you were.
#-------------------------------------------------------------------------------
_site="${BENCH_SITE:-derecho}"
# A ~/.config copy holds ONE site, and its path does not say which.  So it is
# used only when it names the site being asked for; otherwise the search falls
# through to the checkout, which has a profile per machine.  Without this, a
# Derecho copy answers a Casper job and the run is silently wrong.
_profile_site () { ( . "$1" >/dev/null 2>&1; printf '%s' "${BENCH_SITE:-}" ); }

_site_conf=""
if [ -n "${BENCH_SITE_CONF:-}" ] && [ -f "${BENCH_SITE_CONF}" ]; then
    _site_conf="${BENCH_SITE_CONF}"
else
    _c="${XDG_CONFIG_HOME:-${HOME}/.config}/hpcdev/site.sh"
    [ -f "${_c}" ] && [ "$(_profile_site "${_c}")" = "${_site}" ] && _site_conf="${_c}"
fi
_d="$(cd "${PBS_O_WORKDIR:-$(pwd)}" 2>/dev/null && pwd)"
while [ -z "${_site_conf}" ] && [ -n "${_d}" ] && [ "${_d}" != "/" ]; do
    [ -f "${_d}/sites/${_site}/site.sh" ] && _site_conf="${_d}/sites/${_site}/site.sh"
    _d="$(dirname "${_d}")"
done
[ -n "${_site_conf}" ] || {
    echo "cannot find a site profile for '${_site}'." >&2
    echo "  copy containers/deploy/sites/${_site}/site.sh to ~/.config/hpcdev/" >&2
    echo "  and set NCAR_HPC_ROOT in it, or submit from inside the checkout." >&2
    exit 1
}
. "${_site_conf}" || { echo "cannot source ${_site_conf}" >&2; exit 1; }
bench_site_modules || { echo "site module bootstrap failed" >&2; exit 1; }

# Beyond the site bootstrap: this script builds nothing and drives GPU work, so
# it wants a host compiler and the CUDA runtime that the benchmark path does not.
module load gcc cuda 2>/dev/null || true
module list

### Interrogate Environment
env | egrep "PBS|MPI|THREADS" | sort
nodes_list=$(cat $PBS_NODEFILE | sort | uniq)
nodes_list=${nodes_list//.hpc.ucar.edu/}
echo "NODES=\""${nodes_list}"\""

# BENCH_IMAGE_DIR comes from the site profile, so this works from any
# directory rather than only from inside the checkout.
export container_img="${container_img:-${BENCH_IMAGE_DIR}/noble-oneapi-mpich.sif}"

[ -f "${container_img}" ] && echo "container_img=${container_img}" || { echo "cannot locate requested image: ${container_img}"; exit 1; }

apptainer_exec_mpi="apptainer-launch-${NCAR_HOST}-${LMOD_FAMILY_MPI}.sh"

cat <<'EOF' > ${apptainer_exec_mpi} && chmod +x ${apptainer_exec_mpi}
#!/bin/bash

[[ -f "${container_img}" ]] || { echo "cannot locate requested image: ${container_img}"; exit 1; }

if [[ "${container_img}" == *"cuda"* ]]; then
   GTL_PRELOAD=/opt/cray/pe/mpich/${CRAY_MPICH_VERSION}/gtl/lib/libmpi_gtl_cuda.so.0
else
   unset GTL_PRELOAD
fi

$(which apptainer) \
    --quiet \
    exec \
    --nv \
    --bind /glade \
    --bind /local_scratch \
    --bind /run --bind /var/run \
    --bind /opt/cray \
    --bind /usr/lib64:/host/lib64 \
    --env LD_LIBRARY_PATH=${CRAY_MPICH_DIR}/lib-abi-mpich:/opt/cray/pe/lib64:/opt/cray/pals/1.5/lib:${NCAR_ROOT_LIBFABRIC}/lib64:/usr/lib64:/host/lib64 \
    --env LD_PRELOAD=${GTL_PRELOAD} \
    --env MPICH_SMP_SINGLE_COPY_MODE=NONE \
    ${container_img} \
    "${@}"
EOF


osu_root="/container/osu-micro-benchmarks/7.5"

echo "-------------------------------------------------------------------------"
echo "ldd, container native:"
echo "-------------------------------------------------------------------------"
apptainer \
    --quiet \
    exec \
    --nv \
    ${container_img} \
    ldd "${osu_root}/libexec/osu-micro-benchmarks/mpi/collective/osu_alltoall"

echo
echo "-------------------------------------------------------------------------"
echo "ldd, host-binds:"
echo "-------------------------------------------------------------------------"
./${apptainer_exec_mpi} \
    ldd "${osu_root}/libexec/osu-micro-benchmarks/mpi/collective/osu_alltoall"

for collective in osu_allreduce osu_alltoall; do

    container_exe="${osu_root}/libexec/osu-micro-benchmarks/mpi/collective/${collective}"
    echo "-------------------------------------------------------------------------"
    echo "Running ${container_exe}"
    echo "-------------------------------------------------------------------------"

    mpiexec \
        ./${apptainer_exec_mpi} \
        ${container_exe} --message-size 4:8192 --iterations 110 --warmup 10

    nvidia-smi >/dev/null 2>&1 && \
        echo "Using GPU managed memory:" && \
        mpiexec \
            set_gpu_rank \
            ./${apptainer_exec_mpi} \
            ${container_exe} --message-size 4:8192 --iterations 110 --warmup 10 -d managed

done

for pt2pt in osu_latency osu_bibw; do

    container_exe="${osu_root}/libexec/osu-micro-benchmarks/mpi/pt2pt/${pt2pt}"
    echo "-------------------------------------------------------------------------"
    echo "Running ${container_exe} inter-node"
    echo "-------------------------------------------------------------------------"
    mpiexec -n 2 -ppn 1 \
            ./${apptainer_exec_mpi} \
            ${container_exe}

    nvidia-smi >/dev/null 2>&1 && \
        echo "Using GPU device allocated memory:" && \
        mpiexec -n 2 -ppn 1 \
                set_gpu_rank \
                ./${apptainer_exec_mpi} \
                ${container_exe} D D

    echo "-------------------------------------------------------------------------"
    echo "Running ${container_exe} intra-node"
    echo "-------------------------------------------------------------------------"
    mpiexec -n 2 -ppn 2 \
            ./${apptainer_exec_mpi} \
            ${container_exe}

    nvidia-smi >/dev/null 2>&1 && \
        echo "Using GPU device allocated memory:" && \
        mpiexec -n 2 -ppn 2 \
                set_gpu_rank \
                ./${apptainer_exec_mpi} \
                ${container_exe} D D

done


echo && echo && echo "Done at $(date)"
