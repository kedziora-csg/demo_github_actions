#!/bin/bash
#PBS -N OSU_casper
#PBS -A PBS_ACCOUNT_UNSET
# ^ deliberately not a real allocation: pass your own with
#       qsub -A <PROJECT> ...
#   qsub rejects the placeholder rather than silently charging someone else.
#PBS -j oe
#PBS -q casper
#PBS -l walltime=00:05:00
#PBS -l select=2:ncpus=64:mpiprocs=4:ompthreads=4:ngpus=4

#-------------------------------------------------------------------------------
# The cluster profile.  What used to be four hardcoded `module load` lines is
# now one call to bench_site_modules, whose body is generated by merging
# sites/<site>.yaml with sites/<site>/<cluster>.yaml.
#
# That change is not cosmetic.  These three scripts said ncarenv/24.12 while the
# profile said 25.10, and nothing compared them -- which is what a value stated
# in five places does eventually.
#
# The search is the same three places every entry point here looks, first found
# wins: $BENCH_SITE_CONF, then ~/.config/hpcdev/cluster.sh, then
# sites/*/<cluster>/cluster.sh walking up from $PBS_O_WORKDIR.  PBS copies this script into its own spool, so
# $0 does not point at the checkout and $PBS_O_WORKDIR is the only reliable
# record of where you were.
#-------------------------------------------------------------------------------
_cluster="${BENCH_CLUSTER:-casper}"
# A ~/.config copy holds ONE cluster, and its path does not say which.  So it is
# used only when it names the cluster being asked for; otherwise the search falls
# through to the checkout, which has a profile per machine.  Without this, a
# Derecho copy answers a Casper job and the run is silently wrong.
_profile_cluster () { ( . "$1" >/dev/null 2>&1; printf '%s' "${BENCH_CLUSTER:-}" ); }

_site_conf=""
if [ -n "${BENCH_SITE_CONF:-}" ] && [ -f "${BENCH_SITE_CONF}" ]; then
    _site_conf="${BENCH_SITE_CONF}"
else
    _c="${XDG_CONFIG_HOME:-${HOME}/.config}/hpcdev/cluster.sh"
    [ -f "${_c}" ] && [ "$(_profile_cluster "${_c}")" = "${_cluster}" ] && _site_conf="${_c}"
fi
_d="$(cd "${PBS_O_WORKDIR:-$(pwd)}" 2>/dev/null && pwd)"
while [ -z "${_site_conf}" ] && [ -n "${_d}" ] && [ "${_d}" != "/" ]; do
    for _p in "${_d}"/sites/*/"${_cluster}"/cluster.sh; do
        [ -f "${_p}" ] && _site_conf="${_p}"
    done
    _d="$(dirname "${_d}")"
done
[ -n "${_site_conf}" ] || {
    echo "cannot find a cluster profile for '${_cluster}'." >&2
    echo "  copy that cluster's cluster.sh to ~/.config/hpcdev/" >&2
    echo "  and set NCAR_HPC_ROOT in it, or submit from inside the checkout." >&2
    exit 1
}
. "${_site_conf}" || { echo "cannot source ${_site_conf}" >&2; exit 1; }
bench_site_modules || { echo "site module bootstrap failed" >&2; exit 1; }

# Beyond the site bootstrap: this script builds nothing and drives GPU work, so
# it wants a host compiler; sites/casper.yaml already brings in CUDA.
module load gcc 2>/dev/null || true
module list

### Interrogate Environment
env | egrep "PBS|MPI|THREADS" | sort
nodes_list=$(cat $PBS_NODEFILE | sort | uniq)
nodes_list=${nodes_list//.hpc.ucar.edu/}
echo "NODES=\""${nodes_list}"\""

# BENCH_IMAGE_DIR comes from the site profile, so this works from any
# directory rather than only from inside the checkout.
export container_img="${container_img:-${BENCH_IMAGE_DIR}/almalinux9-gcc14-openmpi-cuda.sif}"

[ -f "${container_img}" ] || { echo "cannot locate requested image: ${container_img}"; exit 1; }

apptainer_exec_mpi="apptainer-launch-${NCAR_HOST}-${LMOD_FAMILY_MPI}.sh"

cat <<'EOF' > ${apptainer_exec_mpi} && chmod +x ${apptainer_exec_mpi}
#!/bin/bash

[ -f "${container_img}" ] || { echo "cannot locate requested image: ${container_img}"; exit 1; }

# Set UCX_POSIX_USE_PROC_LINK=n: This environment variable can be set before running your
# Apptainer container to disable the use of /proc links by the UCX POSIX transport.
# This is a common workaround to resolve permission denied issues by switching to
# an alternative communication mode that does not require ptrace capabilities.
export UCX_POSIX_USE_PROC_LINK=n

$(which apptainer) \
    --quiet \
    exec \
    --nv \
    --bind /glade \
    --bind /local_scratch \
    --bind /proc \
    --bind /usr/lib64:/host/lib64 \
    --bind /usr/lpp/mmfs \
    --bind ${NCAR_ROOT_OPENMPI} \
    --env LD_LIBRARY_PATH=${NCAR_ROOT_OPENMPI}/lib:/usr/lib64:/host/lib64:/usr/lpp/mmfs/lib \
   ${container_img} \
   "${@}"
EOF

osu_root="/container/osu-micro-benchmarks/7.5"

echo "-------------------------------------------------------------------------"
echo "ldd, container native:"
echo "-------------------------------------------------------------------------"
apptainer \
    --quiet \
    exec \
    --nv \
    ${container_img} \
    ldd "${osu_root}/libexec/osu-micro-benchmarks/mpi/collective/osu_alltoall"

echo
echo "-------------------------------------------------------------------------"
echo "ldd, host-binds:"
echo "-------------------------------------------------------------------------"
./${apptainer_exec_mpi} \
    ldd "${osu_root}/libexec/osu-micro-benchmarks/mpi/collective/osu_alltoall"

for collective in osu_allreduce osu_alltoall; do

    container_exe="${osu_root}/libexec/osu-micro-benchmarks/mpi/collective/${collective}"
    echo "-------------------------------------------------------------------------"
    echo "Running ${container_exe}"
    echo "-------------------------------------------------------------------------"

    mpiexec \
        ./${apptainer_exec_mpi} \
        ${container_exe} --message-size 4:8192 --iterations 110 --warmup 10

    nvidia-smi >/dev/null 2>&1 && \
        echo "Using GPU managed memory:" && \
        mpiexec \
            set_gpu_rank \
            ./${apptainer_exec_mpi} \
            ${container_exe} --message-size 4:8192 --iterations 110 --warmup 10 -d managed

done

for pt2pt in osu_latency osu_bibw; do

    container_exe="${osu_root}/libexec/osu-micro-benchmarks/mpi/pt2pt/${pt2pt}"
    echo "-------------------------------------------------------------------------"
    echo "Running ${container_exe} inter-node"
    echo "-------------------------------------------------------------------------"
    mpiexec -n 2 --map-by ppr:1:node \
            ./${apptainer_exec_mpi} \
            ${container_exe}

    nvidia-smi >/dev/null 2>&1 && \
        echo "Using GPU device allocated memory:" && \
        mpiexec -n 2 --map-by ppr:1:node \
                set_gpu_rank \
                ./${apptainer_exec_mpi} \
                ${container_exe} D D

    echo "-------------------------------------------------------------------------"
    echo "Running ${container_exe} intra-node"
    echo "-------------------------------------------------------------------------"
    mpiexec -n 2 --map-by ppr:2:node \
            ./${apptainer_exec_mpi} \
            ${container_exe}

    nvidia-smi >/dev/null 2>&1 && \
        echo "Using GPU device allocated memory:" && \
        mpiexec -n 2 --map-by ppr:2:node \
                set_gpu_rank \
                ./${apptainer_exec_mpi} \
                ${container_exe} D D

done


echo && echo && echo "Done at $(date)"
