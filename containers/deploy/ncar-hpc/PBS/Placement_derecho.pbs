#!/bin/bash
#PBS -N placement_derecho
#PBS -A PBS_ACCOUNT_UNSET
# ^ deliberately not a real allocation: pass your own with
#       qsub -A <PROJECT> ...
#   (or use ../submit_placement_matrix.sh --account <PROJECT>).
#   qsub rejects the placeholder rather than silently charging someone else.
#PBS -j oe
#PBS -q main
#PBS -l walltime=00:15:00
#PBS -l select=2:ncpus=128:mpiprocs=16:ompthreads=8

#-------------------------------------------------------------------------------
# Run /container/bin/report_placement inside an Apptainer container on Derecho,
# using the host's MPI library (displacing the container's).
#
# Runs one binding per image based on the PBS Pro chunk specification and
# reports what the run ACTUALLY got via placement_summary, naming any pathology
# it finds rather than asserting against a hardcoded expectation.
#
# This is an integration test of the containers, so it only exercises bindings a
# real job would use.  For what happens when the binding flags are omitted, see
# the captured outputs in libexec/fixtures/ and the note at the sweep below.
#
# Compare with the same binary built natively (see NCAR_HowTo.md); the output
# format is identical, so `diff` is the comparison.
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# Find and source the site profile.  This is the only thing the script knows how
# to do before it knows anything, so it is inline in each PBS script rather than
# in libexec/ -- libexec is one of the things the profile locates.
#
# Search order (first hit wins):
#   1. $BENCH_SITE_CONF                                    explicit, via qsub -v
#   2. ./site.sh in the submission directory               per-run override
#   3. ${XDG_CONFIG_HOME:-$HOME/.config}/hpcdev/site.sh    per-user
#   4. ../sites/<site>/site.sh, walking up from there      in-tree
#
# Rule 3 is what lets this script be qsub'd from any directory on the machine.
# Rule 4 keeps submit-from-the-checkout working with no setup at all.
#
# PBS copies this script into its spool, so $0 does not point at the checkout;
# $PBS_O_WORKDIR is the only reliable clue about where the operator was.
#-------------------------------------------------------------------------------
_find_site_conf () {
    local from="${1:-$(pwd)}" site="${2:-derecho}" d

    [ -n "${BENCH_SITE_CONF:-}" ] && [ -f "${BENCH_SITE_CONF}" ] && {
        printf '%s' "${BENCH_SITE_CONF}"; return 0; }
    [ -f "${from}/site.sh" ] && { printf '%s' "${from}/site.sh"; return 0; }

    d="${XDG_CONFIG_HOME:-${HOME}/.config}/hpcdev/site.sh"
    [ -f "${d}" ] && { printf '%s' "${d}"; return 0; }

    d="$(cd "${from}" 2>/dev/null && pwd)" || return 1
    while [ -n "${d}" ] && [ "${d}" != "/" ]; do
        [ -f "${d}/sites/${site}/site.sh" ] && {
            printf '%s' "${d}/sites/${site}/site.sh"; return 0; }
        d="$(dirname "${d}")"
    done
    return 1
}

_site_conf="$(_find_site_conf "${PBS_O_WORKDIR:-$(pwd)}" "${BENCH_SITE:-derecho}")"
if [ -z "${_site_conf}" ]; then
    echo "cannot find a site profile for '${BENCH_SITE:-derecho}'." >&2
    echo "  looked at: \$BENCH_SITE_CONF, ./site.sh, \${XDG_CONFIG_HOME:-\$HOME/.config}/hpcdev/site.sh," >&2
    echo "             and sites/<site>/site.sh above ${PBS_O_WORKDIR:-$(pwd)}" >&2
    echo "  to run from anywhere, copy containers/deploy/sites/derecho/site.sh to" >&2
    echo "  ~/.config/hpcdev/ and set NCAR_HPC_ROOT in it." >&2
    exit 1
fi
# shellcheck source=../../sites/derecho/site.sh
. "${_site_conf}" || { echo "cannot source ${_site_conf}" >&2; exit 1; }
[ -d "${NCAR_HPC_ROOT:-}/libexec" ] || {
    echo "${_site_conf} does not point NCAR_HPC_ROOT at a checkout with libexec/" >&2
    echo "  NCAR_HPC_ROOT=${NCAR_HPC_ROOT:-<unset>}" >&2
    exit 1
}

bench_site_modules || { echo "site module bootstrap failed" >&2; exit 1; }

nodes_list="$(sort -u $PBS_NODEFILE | tr '\n' ' ' | sed 's/ *$//')"
nodes_list=${nodes_list//.hpc.ucar.edu/}
NUM_NODES="$(sort -u $PBS_NODEFILE | wc -l | tr -d '[:space:]')"
TOTAL_MPI_RANKS=$(wc -l < $PBS_NODEFILE | tr -d '[:space:]')
MPIPROCS_PER_CHUNK=$(grep -c "^$(head -n 1 $PBS_NODEFILE)$" $PBS_NODEFILE)

echo
echo "nodes     ${NUM_NODES}  (${nodes_list})"
echo "geometry  ${MPIPROCS_PER_CHUNK} ranks/node x ${OMP_NUM_THREADS} threads (${TOTAL_MPI_RANKS} ranks)"

#-------------------------------------------------------------------------------
# Integration test over the blessed Derecho image set.  For each image: build the
# launcher, prove the derecho environment displaced the container's MPI, and run
# the realistic hybrid binding.  Emits a PASS/FAIL matrix at the end.
#
# Default set comes from libexec/Makefile so there is one definition of "the six".
# Override with:  qsub -v container_img=/path/to/one.sif ...
#-------------------------------------------------------------------------------

# Artifacts land in the site's results root, which defaults to the directory the
# job was submitted from -- so a per-run directory keeps one certification pass
# together, and a site profile can redirect the lot to scratch instead.
RESULTS_DIR="${RESULTS_DIR:-${BENCH_RESULTS_ROOT}}"
mkdir -p "${RESULTS_DIR}" && cd "${RESULTS_DIR}" \
    || { echo "cannot use RESULTS_DIR=${RESULTS_DIR}" >&2; exit 1; }

# Sourcing these is not optional: without them the loop below silently produces
# an empty matrix, which reads like "no images" rather than "broken harness".
for lib in make_apptainer_launcher.sh check_placement.sh provenance.sh; do
    . "${NCAR_HPC_ROOT}/libexec/${lib}" \
        || { echo "cannot source ${NCAR_HPC_ROOT}/libexec/${lib}" >&2; exit 1; }
done

if [ -n "${container_img:-}" ]; then
    IMAGES="${container_img}"
else
    IMAGES=""
    for i in $(cd "${NCAR_HPC_ROOT}/libexec" && make --no-print-directory echo-derecho); do
        IMAGES="${IMAGES} ${BENCH_IMAGE_DIR}/${i}"
    done
fi

exe="/container/bin/report_placement"
results=""

# Probe this node's topology once.  The placement rules derive every threshold
# from it -- threads per core, the minimum L3 / NUMA / socket groups a rank of N
# cores can occupy -- instead of carrying Milan constants, and check_placement.sh
# picks the file up from the directory the reports are written into.  It is also
# the only record of what hardware certified these images.
probe_topology "$(pwd)/topology.json" \
    || echo "topology probe failed; falling back to built-in Derecho constants"
vshow topology.json "node topology"

# The environment this certification ran under, as files rather than 86 lines of
# job log.  BENCH_VERBOSE=1 echoes them too -- which is what you want the first
# time an image is tried on a new machine.
capture_run_context "$(pwd)"

# This gives one physical core per thread
#export OMP_PROC_BIND=spread
#export OMP_PLACES=threads

# This gives two logical cores per thread
export OMP_PROC_BIND=close
export OMP_PLACES=cores

#-------------------------------------------------------------------------------
# run_placement <outfile> <nranks> <nthreads> <launcher> <exe> [mpiexec flags...]
#
# Write a header to the output file documenting exactly how the run was
# invoked, then execute it.  The .out files are the only artifacts that
# outlive the job, and the header lets you read the placement table without
# opening a second file to find the particulars.
#-------------------------------------------------------------------------------
run_placement () {
    local out="$1" nranks="$2" nthreads="$3" run_launcher="$4" run_exe="$5"
    shift 5
    local flags="$*"

    emit_provenance "${out}" \
        image        "${img}" \
        image_digest "$(sif_digest "${img}")" \
        tag          "${tag}" \
        compiler     "${comp_family}" \
        mpi_family   "${mpi_family}" \
        nodes        "${NUM_NODES}" \
        ranks        "${nranks}" \
        threads      "${nthreads}" \
        mpiexec_flags "${flags:-(none)}" \
        omp          "OMP_PROC_BIND=${OMP_PROC_BIND:-unset} OMP_PLACES=${OMP_PLACES:-unset}" \
        launcher     "${run_launcher}" \
        launch       "OMP_NUM_THREADS=${nthreads} mpiexec -n ${nranks} ${flags} ${run_launcher} ${run_exe}"

    OMP_NUM_THREADS="${nthreads}" mpiexec -n "${nranks}" ${flags} \
        "${run_launcher}" "${run_exe}" >> "${out}" 2>&1
}

for img in ${IMAGES}; do
    tag="$(basename ${img} .sif)"

    echo
    echo "#######################################################################"
    echo "# ${tag}"
    echo "#######################################################################"

    if [ ! -f "${img}" ]; then
        echo "  MISSING image -- build it with: cd libexec && make derecho"
        results="${results}\n${tag} SKIP SKIP no-image"
        continue
    fi

    #---------------------------------------------------------------------------
    # Select the host toolchain that matches this image.  Sniff the compiler and
    # MPI family from the image name, then load the corresponding Derecho modules
    # (compiler first, then the MPI).  make_apptainer_launcher needs the host
    # OpenMPI already loaded so NCAR_ROOT_OPENMPI resolves; the mpiexec dialect
    # below also depends on which family we picked.
    #---------------------------------------------------------------------------
    comp_family="$(_launcher_sniff_compiler "${img}")"
    mpi_family="${container_mpi:-$(_launcher_sniff_family "${img}")}"
    echo "  toolchain compiler=${comp_family} mpi=${mpi_family}"
    if ! load_host_modules "${comp_family}" "${mpi_family}"; then
        results="${results}\n${tag} FAIL FAIL modules"
        continue
    fi

    launcher="./apptainer-launch-${NCAR_HOST}-${tag}.sh"
    if ! make_apptainer_launcher "${launcher}" "${img}" "${mpi_family}"; then
        results="${results}\n${tag} FAIL FAIL launcher"
        continue
    fi

    #---------------------------------------------------------------------------
    # Does the host MPI actually displace the container's?  If libmpi still
    # resolves under /container the run below would produce N singletons and
    # look almost plausible, so stop here rather than mislead.
    #---------------------------------------------------------------------------
    # Full linkage to a file; the one line that matters to stdout.  The two
    # files are named for whose libraries they resolve to -- the CONTAINER's own,
    # and the HOST's after the launcher substitutes them -- because that
    # substitution is the entire thing being certified.
    apptainer --quiet exec ${img} ldd ${exe} > "ldd_${tag}_container.txt" 2>&1
    ${launcher}                    ldd ${exe} > "ldd_${tag}_host.txt" 2>&1
    vshow "ldd_${tag}_container.txt" "ldd inside the container: ${tag}"
    vshow "ldd_${tag}_host.txt"      "ldd through the launcher (host): ${tag}"

    host_mpi="$(grep -i 'libmpi\.so' "ldd_${tag}_host.txt" 2>/dev/null)"
    echo "  libmpi -> $(echo "${host_mpi}" | head -1 | sed 's/^[[:space:]]*//')"
    case "${host_mpi}" in
        *"/container/"*|"")
            echo "    *** still linking the container's MPI -- see ldd_${tag}_host.txt ***"
            results="${results}\n${tag} FAIL FAIL container-mpi"
            continue
            ;;
    esac

    #---------------------------------------------------------------------------
    # Translate the placement launch flags into this image's MPI dialect.  Cray
    # PALS (mpich) spells procs-per-node -ppn and depth binding --cpu-bind depth;
    # Open MPI 5.0 (openmpi) spells them -N and --map-by ...:pe=N --bind-to core.
    #---------------------------------------------------------------------------
    bound_flags="$(mpi_launch_flags "${mpi_family}" $MPIPROCS_PER_CHUNK $OMP_NUM_THREADS bound)"

    run_placement "placement_${tag}_bound.out" $(( NUM_NODES * MPIPROCS_PER_CHUNK )) $OMP_NUM_THREADS \
        "${launcher}" "${exe}" ${bound_flags}

    # PASS/FAIL certifies the IMAGE, so it keys on `fail` only: a warn names a
    # suboptimal placement, which is a property of how this job asked for the
    # binding, not of whether the host MPI displaced the container's.  The pathology
    # is printed either way by placement_summary above.
    placement_summary "placement_${tag}_bound.out"
    v="$(placement_verdict "placement_${tag}_bound.out")"
    case "${v}" in fail|nodata) a=FAIL ;; *) a=PASS ;; esac

    results="${results}\n${tag} ${a} ${v}"
done

#-------------------------------------------------------------------------------
echo
echo "======================================================================="
echo "INTEGRATION MATRIX"
echo "======================================================================="
printf "  %-28s %-10s %s\n" IMAGE PLACEMENT NOTE
printf "  %-28s %-10s %s\n" ---------------------------- ---------- ----
echo -e "${results}" | while read -r t a n; do
    [ -n "${t}" ] || continue
    printf "  %-28s %-10s %s\n" "${t}" "${a}" "${n}"
done
echo
echo "  PLACEMENT=PASS means the host MPI libraries displaced the container's own"
echo "  (for mpich that is the Cray ABI shim; for openmpi a direct bind) and no severe"
echo "  placement pathology was found.  The NOTE column carries the checker's own"
echo "  verdict: ok, or warn for an avoidable straddle that does not disqualify"
echo "  the image.  FAIL prints the specific pathology above."

echo && echo "Done at $(date)"
