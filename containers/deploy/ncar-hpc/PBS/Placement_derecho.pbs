#!/bin/bash
#PBS -N placement_derecho
#PBS -A SCSG0001
#PBS -j oe
#PBS -q main
#PBS -l walltime=00:15:00
#PBS -l select=2:ncpus=128:mpiprocs=8:ompthreads=16

#-------------------------------------------------------------------------------
# Run /container/bin/report_placement inside an Apptainer container on Derecho,
# using host Cray MPICH via the MPICH ABI shim.
#
# Requests whole nodes (ncpus=128) deliberately: with only a couple of cores per
# node every rank lands on the same chiplet, socket and NUMA node, and the
# socket / numa / l3 columns cannot tell you anything.
#
# Sweeps four bindings so the difference is visible side by side:
#   A. depth 1, 1 thread per rank    -- packs all 8 ranks onto cores 0-7
#   B. depth 16, 16 threads per rank <- the realistic hybrid case
#   C. no --cpu-bind at all          -- the trap: NOT unbound, see below
#   D. --cpu-bind none + OMP_PROC_BIND=false -- a genuinely unbound baseline
#
# C and D are different on purpose.  "Omit the flag" and "ask for none" produce
# opposite outcomes here, which is the single most surprising thing this script
# demonstrates.
#
# Compare with the same binary built natively (see NCAR_HowTo.md); the output
# format is identical, so `diff` is the comparison.
#-------------------------------------------------------------------------------

>/dev/null 2>&1 \
           module --force purge && \
           module load ncarenv/25.10 && \
           module reset && \
           module load gcc/14.3.0 && \
           module load apptainer
module list

### Interrogate Environment
echo && echo "--- PBS, MPI, and Threads environment ---"
env | egrep "PBS|MPI|THREADS|CRAY_MPICH" | sort
nodes_list=$(cat $PBS_NODEFILE | sort | uniq)
nodes_list=${nodes_list//.hpc.ucar.edu/}
echo "\nNODES=\""${nodes_list}"\""

export container_img="${container_img:-$(pwd)/libexec/leap-gcc-mpich.sif}"

[ -f "${container_img}" ] && echo "container_img=${container_img}" \
    || { echo "cannot locate requested image: ${container_img}"; exit 1; }

# Cray MPICH exposes two library directories.  lib/ is the native Cray build;
# lib-abi-mpich/ is the ABI-compatible shim exporting libmpi.so.12 with stock
# MPICH's symbol layout.  ONLY the latter can displace the container's own
# MPICH.  Point at lib/ and every rank silently singleton-initialises into its
# own MPI_COMM_WORLD of size 1 -- the job "runs", it is just N serial programs.
CRAY_MPI="${CRAY_MPICH_DIR:-${CRAY_MPICH_PREFIX}}"
[ -d "${CRAY_MPI}/lib-abi-mpich" ] && echo "ABI shim: ${CRAY_MPI}/lib-abi-mpich" \
    || { echo "no lib-abi-mpich under '${CRAY_MPI}' -- is cray-mpich loaded?"; exit 1; }

# Prefer the module-provided roots over hardcoded version numbers, which change
# under us at the next system update.
PALS_LIB="$(ls -d /opt/cray/pals/*/lib 2>/dev/null | tail -1)"
FABRIC_LIB="${NCAR_ROOT_LIBFABRIC:+${NCAR_ROOT_LIBFABRIC}/lib64}"
FABRIC_LIB="${FABRIC_LIB:-$(ls -d /opt/cray/libfabric/*/lib64 2>/dev/null | tail -1)}"

apptainer_exec_mpi="apptainer-launch-${NCAR_HOST}-${LMOD_FAMILY_MPI}.sh"

cat <<EOF > ${apptainer_exec_mpi} && chmod +x ${apptainer_exec_mpi}
#!/bin/bash
\$(which apptainer) \\
    --quiet \\
    exec \\
    --bind /glade \\
    --bind /local_scratch \\
    --bind /run --bind /var/run \\
    --bind /opt/cray \\
    --bind /etc/cray \\
    --bind /usr/lib64:/host_lib64 \\
    --env LD_LIBRARY_PATH=${CRAY_MPI}/lib-abi-mpich:/opt/cray/pe/lib64:${PALS_LIB}:${FABRIC_LIB}:/usr/lib64:/host_lib64 \\
    --env MPICH_SMP_SINGLE_COPY_MODE=NONE \\
    --env MPICH_VERSION_DISPLAY=1 \\
    ${container_img} \\
    "\${@}"
EOF

echo && echo "--- generated launcher ---" && cat ${apptainer_exec_mpi}

exe="/container/bin/report_placement"

#-------------------------------------------------------------------------------
# Before running anything: prove the shim actually took.  libmpi.so.12 must
# resolve under /opt/cray, NOT under /container.  If it does not, stop here --
# the run below would produce N singletons and look almost plausible.
#-------------------------------------------------------------------------------
echo
echo "======================================================================="
echo "ldd, container native (no host binds):"
echo "======================================================================="
apptainer --quiet exec ${container_img} ldd ${exe} | grep -i mpi

echo
echo "======================================================================="
echo "ldd, through the launcher (expect /opt/cray):"
echo "======================================================================="
./${apptainer_exec_mpi} ldd ${exe} | grep -i mpi

export OMP_PROC_BIND=spread
export OMP_PLACES=cores

#-------------------------------------------------------------------------------
# A. one thread per rank, pinned
#-------------------------------------------------------------------------------
echo
echo "======================================================================="
echo "A. 8 ranks/node x 1 thread, --cpu-bind depth   (expect nallowed 1)"
echo "======================================================================="
OMP_NUM_THREADS=1 \
    mpiexec -n 16 -ppn 8 --cpu-bind depth -d 1 \
        ./${apptainer_exec_mpi} ${exe}

#-------------------------------------------------------------------------------
# B. The realistic hybrid case, and the one to read closely.  MEASURED:
#
#    Each rank gets a 16-core block (rank 0 -> 0-15, rank 1 -> 16-31, ...), but
#    every *thread* reports nallowed 1: PALS hands the rank a 16-core mask, then
#    OMP_PROC_BIND=spread + OMP_PLACES=cores pins each thread to one core within
#    it.  Two layers of binding, both doing their job.
#
#    Milan puts 8 cores on each L3, so a 16-thread rank straddles 2 chiplets --
#    watch l3 change mid-rank (threads 0-7 -> l3 0, threads 8-15 -> l3 8).
#    Across the node: ranks 0-3 on socket 0, 4-7 on socket 1, and 8 distinct
#    NUMA domains, i.e. these nodes are configured NPS4.
#-------------------------------------------------------------------------------
echo
echo "======================================================================="
echo "B. 8 ranks/node x 16 threads, --cpu-bind depth  (16-core rank, 1/thread)"
echo "======================================================================="
OMP_NUM_THREADS=16 \
    mpiexec -n 16 -ppn 8 --cpu-bind depth -d 16 \
        ./${apptainer_exec_mpi} ${exe}

#-------------------------------------------------------------------------------
# C. The trap.  MEASURED on Derecho (job 7014925, 2 x EPYC 7763):
#
#    Omitting --cpu-bind does NOT leave threads free.  PALS still binds each
#    rank to a SINGLE core (rank 0 -> cpu 0, rank 1 -> cpu 1, ...), all 16
#    OpenMP threads inherit that one-core mask, and OMP_PLACES=cores then finds
#    exactly one place available -- so every thread lands on it:
#
#      MPI rank 0/16 thread  0/16 ... cpu 0 ... nallowed 1 affinity 0
#      MPI rank 0/16 thread 15/16 ... cpu 0 ... nallowed 1 affinity 0
#
#    That is 16 threads time-slicing one core, per rank, while 120 cores idle.
#    Invisible from the cpu column alone -- rank 0 thread 0 on cpu 0 looks
#    perfectly normal.  Only nallowed 1 *combined with* every thread reporting
#    the SAME cpu reveals it.
#
#    On Derecho, --cpu-bind is not optional for hybrid jobs: omitting it is
#    worse than being unbound.  Compare with D.
#-------------------------------------------------------------------------------
echo
echo "======================================================================="
echo "C. 8 ranks/node x 16 threads, NO --cpu-bind   (nallowed 1, all on one cpu)"
echo "======================================================================="
OMP_NUM_THREADS=16 \
    mpiexec -n 16 -ppn 8 \
        ./${apptainer_exec_mpi} ${exe}

#-------------------------------------------------------------------------------
# D. A genuinely unbound baseline.  This needs BOTH knobs, which is itself the
#    lesson -- there are two independent layers of binding:
#
#      --cpu-bind none      removes the mask the LAUNCHER (PALS) applies
#      OMP_PROC_BIND=false  stops the OPENMP RUNTIME re-binding within it
#
#    Drop only the first and OMP_PROC_BIND=spread will happily re-pin each
#    thread to its own core out of all 128 -- nallowed goes back to 1, with the
#    ranks now overlapping each other across the whole node.  Drop only the
#    second and the rank stays confined to its PALS mask.
#
#    Expectation (to verify, not assume): nallowed 128 and place '-' on every
#    row, threads free to migrate anywhere on the node.
#-------------------------------------------------------------------------------
echo
echo "======================================================================="
echo "D. 8 ranks/node x 16 threads, --cpu-bind none + OMP_PROC_BIND=false"
echo "                                              (expect nallowed 128)"
echo "======================================================================="
OMP_NUM_THREADS=16 OMP_PROC_BIND=false \
    mpiexec -n 16 -ppn 8 --cpu-bind none \
        ./${apptainer_exec_mpi} ${exe}

#-------------------------------------------------------------------------------
# Collect the machine-readable rows from all four sweeps for spreadsheet work:
#   grep '^csv: ' placement_derecho.o<jobid> | cut -d' ' -f2- > placement.csv
#
# Useful once loaded:  sort by nallowed to find unpinned threads; count distinct
# l3 per rank to find chiplet-straddling ranks; pivot cpu by host to find cores
# with more than one thread on them.
#-------------------------------------------------------------------------------

echo && echo && echo "Done at $(date)"
