# This TEMPLATED singulatrity Definition file will
# be used to construct specific instances based on a make rule,
# see for example "PLACEHOLDER_IMG_NAME" in Makefile

Bootstrap: docker
From: ghcr.io/kedziora-csg/hpcdev-x86_64:<PLACEHOLDER_IMG_TAG>-latest
%post
    cat <<'EOF' >> /container/config_env.sh
export NVCC_PREPEND_FLAGS=${NVCC_PREPEND_FLAGS//all-major/native}
export NCAR_BUILD_ENV="<PLACEHOLDER_IMG_TAG>"
export LS_COLORS="no=00:fi=00:di=01;31:ln=01;34:pi=40;33:so=01;35:bd=40;33;01:cd=40;33;01:or=01;05;37;41:mi=01;05;37;41:ex=01;35:*.cmd=01;32:*.exe=01;32:*.com=01;32:*.btm=01;32:*.bat=01;32:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.gz=01;31:*.jpg=01;35:*.gif=01;35:*.bmp=01;35:*.xbm=01;35:*.xpm=01;35:"
alias ls="ls --color"
EOF
    echo "source /container/config_env.sh" >>${SINGULARITY_ENVIRONMENT}
    echo 'export PS1="<PLACEHOLDER_IMG_TAG>> "' >>${SINGULARITY_ENVIRONMENT}

# Stamped by libexec/Makefile via pin_image_digest.sh.  A .sif is a flattened
# SquashFS with no layer identity, so these labels are the only way a finished
# image can name the build it came from -- and therefore the only way a
# benchmark result can name an artifact rather than a mutable tag.
# base.digest reads `unknown` when it could not be resolved at build time.
# Comments must stay OUTSIDE this section: every non-empty line inside %labels
# is parsed as `KEY VALUE`.
%labels
    org.opencontainers.image.base.name ghcr.io/kedziora-csg/hpcdev-x86_64:<PLACEHOLDER_IMG_TAG>-latest
    org.opencontainers.image.base.digest <PLACEHOLDER_BASE_DIGEST>
    io.ncar.hpcdev.image_tag <PLACEHOLDER_IMG_TAG>

%runscript
    cat <<EOF
Welcome to "$(basename ${SINGULARITY_NAME} .sif)"

See /container/config_env.sh for a listing of the installed environment.

--> Type 'exit' to leave this containerized environment.

EOF
    # start bash, resulting in an interactive shell.
    # but ignore any user ~/.profile etc... which would be coming
    # from the host
    /bin/bash --noprofile --norc



