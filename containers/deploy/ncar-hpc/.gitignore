*.def
*~
*.sif
bin/
*-launch-*.sh
INSTALL/

# Job artifacts.  Anchored to this directory on purpose: a bare `topology.json`
# would also swallow libexec/fixtures/topology.json, which IS committed and is
# what makes the placement tests runnable off-cluster.
/results/
/results.jsonl
/run.meta
/app.yaml
/topology.json
/modules.txt
/env.txt
/launcher.sh
/ldd_*.txt
/placement_*.out
/run_*/

# Generated per job by bench/submit, beside the results they describe.
/job.env
/job.json
/job.pbs
/job.log
