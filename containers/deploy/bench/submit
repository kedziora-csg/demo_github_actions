#!/usr/bin/env python3
"""submit -- expand an experiment into jobs, generate a script for each, submit.

    submit <experiment> --account <PROJECT> [options]
    submit <experiment> --dry-run                    generate everything, submit nothing

    --account CODE       scheduler project to charge.  REQUIRED, no default.
    --profile NAME       run only the cell a profile names -- the sweep's answer
    --images "a b"       override the image list
    --nodes N            override defaults.nodes
    --walltime HH:MM:SS  override defaults.walltime
    --results-dir DIR    where the per-job directories go
    --dry-run            write job.pbs/job.env/job.json, print the qsub, stop
    --force              reuse a results directory that already holds results
    --site NAME          override the site named in the experiment

WHAT EACH JOB IS GIVEN

A directory per job, holding what it was asked to do BEFORE it runs and what it
found AFTER:

    job.pbs    the generated script with real directives. This is what will be
               submitted and will be preserved.
    job.env    the flat expansion the runner sources.  The job never parses YAML
    job.json   the same, structured, for provenance and bench/collect

and then everything runner.sh writes: results.jsonl, run.meta, topology.json,
placement_*.out, run_<cell>/.

VALIDATION IS THE SAME CODE PATH AS `validate`

Same load, same expansion, same checks, same exit codes.  A green validate
followed by a submit that refuses would be the worst possible outcome, so there
is only one implementation for both to be right about.
"""

import argparse
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from benchlib import (BenchError, EXIT_CONTRACT, EXIT_ERROR, EXIT_IMAGE,
                      EXIT_NAMES, EXIT_OK, EXIT_USAGE)
from benchlib import checks, experiment as exp_mod, jobfile


def template_for(site):
    """The job script skeleton, most specific first.

        sites/<site>/job.tmpl        this site needs directives of its own
        sites/job.<scheduler>.tmpl   the default for every site on that scheduler

    Most sites need no template of their own.  A PBS Pro directive block is the
    same on Derecho as it is on Casper -- the queue, the node count and the
    walltime are substituted, and everything else a site needs it already gets
    from its profile.  So the shared one is the normal case and a per-site file
    is the exception, which is the opposite of how this started.  A Slurm site
    is then one new sites/job.slurm.tmpl rather than one per machine.

    A profile copied to ~/.config/hpcdev/ has no template beside it, so the
    checkout is searched too: the template belongs to the harness, and making
    every operator copy two files would be a second thing to keep in step.
    """
    roots = [os.path.dirname(site.conf)]
    if site.bench_root:
        roots.append(os.path.join(os.path.dirname(site.bench_root), "sites",
                                  site.name))
    candidates = [os.path.join(d, "job.tmpl") for d in roots]

    if site.bench_root:
        shared = os.path.join(os.path.dirname(site.bench_root), "sites")
        candidates.append(os.path.join(shared, "job.%s.tmpl" % site.scheduler))
    candidates.append(os.path.join(os.path.dirname(site.conf), os.pardir,
                                   "job.%s.tmpl" % site.scheduler))

    for candidate in candidates:
        if os.path.isfile(candidate):
            return candidate
    raise BenchError("no job template for site %r" % site.name, EXIT_ERROR,
                     ["looked for, in order:"] +
                     ["    " + os.path.normpath(c) for c in candidates] +
                     ["scheduler is %r, from the generated block of %s"
                      % (site.scheduler or "<unset>", site.conf)])


def main():
    ap = argparse.ArgumentParser(
        description="Expand an experiment into jobs and submit them.")
    ap.add_argument("name", help="experiment name or path")
    ap.add_argument("--account", help="scheduler project to charge (required to submit)")
    ap.add_argument("--site", help="override the site named in the experiment")
    ap.add_argument("--profile", help="run only the cell this profile names")
    ap.add_argument("--images", help="override the image list (space separated)")
    ap.add_argument("--nodes", type=int, help="override defaults.nodes")
    ap.add_argument("--walltime", help="override defaults.walltime")
    ap.add_argument("--results-dir", help="where the per-job directories go")
    ap.add_argument("--dry-run", action="store_true",
                    help="generate the job files, print the qsub, submit nothing")
    ap.add_argument("--force", action="store_true",
                    help="reuse a results directory that already holds results")
    args = ap.parse_args()

    exp = exp_mod.load(args.name, args.site)
    if args.nodes:
        exp.defaults["nodes"] = args.nodes
    if args.walltime:
        exp.defaults["walltime"] = args.walltime

    jobs = exp_mod.expand(exp, args.profile,
                          args.images.split() if args.images else None)

    account = args.account or exp.account
    if not account and not args.dry_run:
        print("error: --account is required (no default; this is a billable "
              "allocation).", file=sys.stderr)
        print("       set `account:` in %s, or pass --account." % exp.path,
              file=sys.stderr)
        return EXIT_USAGE

    # Check the world before queueing anything.  A missing .sif is a job that
    # waits in a queue to print one line and exit.
    image_results = checks.images(exp.site, sorted({j.image for j in jobs}))
    missing = [r for r in image_results if r.state == "missing"]
    if missing:
        print("error: these .sif images do not exist:", file=sys.stderr)
        for result in missing:
            print("    %s" % result.detail, file=sys.stderr)
        target = (exp.data["images"].get("from_make") or "derecho")
        print("  build them with:  cd %s/libexec && make %s"
              % (exp.site.root, target), file=sys.stderr)
        return EXIT_IMAGE

    contract_results = checks.contracts(exp.site,
                                        [(j.image, j.app["name"]) for j in jobs])
    missing = [r for r in contract_results if r.state == "missing"]
    if missing:
        print("error: these images carry no contract for the app:", file=sys.stderr)
        for result in missing:
            print("    %s -- %s" % (result.subject, result.detail), file=sys.stderr)
        return EXIT_CONTRACT

    # Absolute from here on.  This path is written into `#PBS -o` and into
    # job.env's RESULTS_DIR, and the job resolves neither from where you were
    # standing: PBS reads a relative -o against the submission directory, and
    # runner.sh cd's into RESULTS_DIR from whatever directory the job starts in.
    # A relative --results-dir would put the log somewhere nobody looks and send
    # the results after it.
    root = os.path.abspath(
        args.results_dir or os.path.join(exp.site.results_root, exp.name))
    template = template_for(exp.site)
    # A per-site job.tmpl silently overrides the shared one and can carry
    # directives no site file mentions, so it is never left unsaid: removing a
    # key from the YAML changes nothing if a forked template hardcodes it.
    shared = os.path.join(os.path.dirname(exp.site.bench_root), "sites",
                          "job.%s.tmpl" % exp.site.scheduler)
    site_template = os.path.abspath(template) != os.path.abspath(shared)

    print("experiment : %s" % exp.path)
    print("site       : %s   (%s)" % (exp.site.name, exp.site.conf))
    print("account    : %s" % (account or "<none: dry run>"))
    print("nodes      : %d    walltime: %s    repeats: %d"
          % (exp.defaults["nodes"], exp.defaults["walltime"], exp.defaults["repeats"]))
    # Printed because these are the two things most often overridden from the
    # environment, and "did that take effect?" should not need reading a
    # generated file to answer.
    print("queue      : %s%s"
          % (exp.defaults["queue"],
             "    place: %s" % exp.site.place if exp.site.place else ""))
    print("results    : %s" % root)
    if site_template:
        print("template   : %s" % template)
        print("             ^ a per-site template, overriding sites/job.%s.tmpl."
              % exp.site.scheduler)
        print("               Directives in it are NOT described by any site file.")
    if args.profile:
        print("profile    : %s" % args.profile)
    print("jobs       : %d  (%d cell(s), %d run(s))"
          % (len(jobs), sum(len(j.cells) for j in jobs),
             sum(len(j.cells) * j.repeats for j in jobs)))
    print()

    occupied = []
    for job in jobs:
        if os.path.exists(os.path.join(root, job.key, "results.jsonl")):
            occupied.append(os.path.join(root, job.key))
    if occupied and not args.force:
        print("error: these results directories already hold a results.jsonl:",
              file=sys.stderr)
        for path in occupied:
            print("    %s" % path, file=sys.stderr)
        print("  a second job would append to them, mixing two runs in one file.",
              file=sys.stderr)
        print("  move them aside, pass --results-dir, or --force to append anyway.",
              file=sys.stderr)
        return EXIT_USAGE

    failed = 0
    for job in jobs:
        results_dir = os.path.join(root, job.key)
        script = jobfile.write(exp, job, results_dir, template,
                               account or "PBS_ACCOUNT_UNSET", args.profile)
        if args.dry_run:
            print("  qsub %s" % script)
            continue
        try:
            out = subprocess.check_output(["qsub", script], cwd=results_dir,
                                          stderr=subprocess.STDOUT)
            print("  submitted %-34s %s" % (job.key, out.decode().strip()))
        except (OSError, subprocess.CalledProcessError) as exc:
            detail = getattr(exc, "output", b"")
            print("  FAILED    %-34s %s" % (job.key, (detail or b"").decode().strip()
                                            or exc))
            failed += 1

    print()
    if args.dry_run:
        print("(dry run -- job.pbs, job.env and job.json written, nothing submitted)")
    elif failed:
        print("%d of %d job(s) failed to submit." % (failed, len(jobs)))
        return EXIT_ERROR
    else:
        print("when the jobs finish:")
        print("    %s/collect %s --best" % (exp.site.bench_root, root))
    return EXIT_OK


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BenchError as exc:
        print("%s: %s" % (EXIT_NAMES.get(exc.code, "error"), exc), file=sys.stderr)
        for line in exc.detail:
            print("  " + line, file=sys.stderr)
        sys.exit(exc.code)
    except OSError as exc:
        print("error: %s" % exc, file=sys.stderr)
        sys.exit(EXIT_ERROR)
