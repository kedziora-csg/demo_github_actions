#!/usr/bin/env python3
"""collect -- turn results.jsonl files into something you can read.

    collect [ROOT ...] [--format table|csv|json] [--best] [--emit-profile]
            [--include-failed] [--per-run]

ROOT defaults to containers/deploy/ncar-hpc/results.  Every results.jsonl at or
below each ROOT is read; rows are tagged with the directory they came from, so
one invocation summarises a whole matrix of jobs.

WHY THIS IS A READ-TIME TOOL
------------------------------------------------------------------------------
The job writes JSONL and never a table.  Metric sets differ per app, so the set
of columns is not knowable when the first row is written -- but it is trivially
knowable once the rows are in hand.  Deciding the schema up front would mean
either a union header rewritten every time an app is added, or dropping metrics
that no one anticipated.

Appending is also crash-safe: a job killed at walltime leaves every completed
cell intact and loses only the one that was running.

WHICH ROWS MAY WIN
------------------------------------------------------------------------------
A row is COMPARABLE unless one of the following holds, in which case it is
printed with its reason and excluded from --best:

    placement.verdict == "fail"   the run measured its binding, not the code
    valid == false                the app said its own result was not valid
    exit != 0                     it did not finish

`warn` is comparable: the placement is suboptimal, but it is the placement that
was measured, and the rule that fired is named in the row.

The first cell of each job carries warm=false -- it paid the cold read of the
.sif off GPFS and the first per-rank Apptainer startup.  It is comparable, but
--best notes when the winner is one, because that cost is an artifact of
ordering rather than of the configuration.

REPEATS: MIN AND MEDIAN, NOT ONE SAMPLE
------------------------------------------------------------------------------
An experiment's `repeats:` runs each cell N times and writes N rows, which
differ only in `repeat`.  --best groups them and ranks on the MEDIAN: a mean
follows one run that hit a noisy neighbour, and a single sample of a shared
machine is not a measurement at all.  The min is printed beside it because the
gap between them is the run-to-run spread, which is the thing that says whether
a difference between two configurations means anything.

--per-run shows every row instead of the grouped table.

--EMIT-PROFILE CLOSES THE LOOP
------------------------------------------------------------------------------
The point of a sweep is a configuration you then run.  --emit-profile writes the
winner as a `profiles:` block you paste into the experiment file, so what the
benchmark produces is the production configuration itself rather than a table
someone transcribes it from by hand.

NOTE ON LOCATION
------------------------------------------------------------------------------
BenchmarkRunnerPlan.md section 8 puts this under containers/deploy/bench/, and
section 11 open question 1 asks whether it belongs there at all -- it is neither
a container nor a deployment.  Moving it is one `git mv`; nothing here depends
on the path.
"""

import argparse
import csv
import json
import os
import sys

DEFAULT_ROOT = os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "ncar-hpc", "results"
)


def find_result_files(roots):
    """Every results.jsonl at or below each root, plus roots named directly."""
    found = []
    for root in roots:
        if os.path.isfile(root):
            found.append(root)
            continue
        for dirpath, _dirnames, filenames in os.walk(root):
            if "results.jsonl" in filenames:
                found.append(os.path.join(dirpath, "results.jsonl"))
    return sorted(set(found))


def load_app_yaml(path):
    """Read primary_fom and each metric's direction from an app.yaml.

    app_resolve copies app.yaml into the results directory beside the rows it
    describes, so a results directory carries its own answer to "which number
    decides" -- no image, no config file, no knowledge of the app here.

    Deliberately a small reader, not a YAML parser: it wants two shapes, the
    top-level `primary_fom: name` and the `better: higher|lower` inside
    figures_of_merit. Anything it does not understand is simply not used.
    """
    fom, better = None, {}
    try:
        with open(path) as fh:
            in_foms = False
            for line in fh:
                stripped = line.strip()
                if stripped.startswith("primary_fom:"):
                    fom = stripped.split(":", 1)[1].strip().strip("\"'")
                elif line.startswith("figures_of_merit:"):
                    in_foms = True
                elif in_foms and line[:1] not in (" ", "\t"):
                    in_foms = False
                elif in_foms and ":" in stripped:
                    name = stripped.split(":", 1)[0].strip()
                    if "better: lower" in stripped:
                        better[name] = "lower"
                    elif "better: higher" in stripped:
                        better[name] = "higher"
    except OSError:
        pass
    return fom, better


def load_rows(paths):
    """Parse every row, keeping going past a truncated final line.

    A job killed mid-write leaves a partial last line.  That is one lost cell,
    not a lost job, so say so and read the rest rather than refusing the file.
    """
    rows, damaged = [], []
    for path in paths:
        job = os.path.basename(os.path.dirname(path))
        fom, better = load_app_yaml(os.path.join(os.path.dirname(path), "app.yaml"))
        with open(path) as fh:
            for lineno, line in enumerate(fh, 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    damaged.append("%s:%d" % (path, lineno))
                    continue
                row["_job"] = job
                row["_path"] = path
                row["_fom"], row["_better"] = fom, better
                rows.append(row)
    return rows, damaged


def get(row, path, default=""):
    """Fetch a dotted path, tolerating absent intermediate objects."""
    cur = row
    for part in path.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return default if cur is None else cur


def excluded_because(row):
    """Why this row may not win, or None."""
    if get(row, "skipped", False) is True:
        return "skipped: " + str(get(row, "skip_reason", "the app declined this geometry"))
    if get(row, "exit", 0) not in (0, ""):
        return "exit=%s" % get(row, "exit")
    if get(row, "valid", True) is False:
        return "app reported invalid"
    if get(row, "placement.verdict") == "fail":
        rules = get(row, "placement.rules", []) or []
        return "placement fail" + (" (%s)" % ", ".join(rules) if rules else "")
    return None


def metric_names(rows):
    names = []
    for row in rows:
        for name in row.get("metrics", {}) or {}:
            if name not in names:
                names.append(name)
    return names


def fmt(value):
    return "-" if value == "" or value is None else str(value)


def cell_key(row):
    """What makes two rows the same CELL: everything except which repeat."""
    return (row["_job"], get(row, "app.name"), get(row, "placement.name"),
            get(row, "placement.omp_variant"))


def group_cells(rows):
    """Rows that differ only by `repeat`, collapsed one entry per cell.

    Order is preserved so a grouped table reads in the order the job ran.
    """
    groups = []
    index = {}
    for row in rows:
        key = cell_key(row)
        if key not in index:
            index[key] = len(groups)
            groups.append((key, []))
        groups[index[key]][1].append(row)
    return groups


def stat(values):
    """(min, median) of a list of numbers, or (None, None).

    Median rather than mean: a mean follows the one run that hit a noisy
    neighbour, which is exactly the run a comparison should be least sensitive
    to.
    """
    values = sorted(v for v in values if isinstance(v, (int, float)))
    if not values:
        return None, None
    mid = len(values) // 2
    median = values[mid] if len(values) % 2 else (values[mid - 1] + values[mid]) / 2.0
    return values[0], median


def cell_stat(pool, metric):
    return stat([get(r, "metrics." + metric, None) if metric != "wall_s"
                 else get(r, "wall_s", None) for r in pool])


def repeated(rows):
    """True when any cell was run more than once."""
    return any(_num(get(row, "repeats", 1)) > 1 for row in rows)


def _num(value):
    try:
        return float(value)
    except (TypeError, ValueError):
        return 1


def print_grouped_table(rows, metrics):
    """One line per cell, with the median across its repeats.

    The per-run rows are still there in results.jsonl and one --per-run away;
    what this collapses is a table that would otherwise triple in length and
    say the same thing three times.
    """
    groups = group_cells(rows)
    cols = [
        ("IMAGE", lambda k, p: get(p[0], "image.sif", p[0]["_job"])),
        ("APP", lambda k, p: get(p[0], "app.name")),
        ("PLACEMENT", lambda k, p: get(p[0], "placement.name")),
        ("OMP", lambda k, p: get(p[0], "placement.omp_variant")),
        ("R/NODE", lambda k, p: get(p[0], "placement.ranks_per_node")),
        ("THREADS", lambda k, p: get(p[0], "placement.threads")),
        ("N", lambda k, p: len([r for r in p if excluded_because(r) is None])),
    ]
    for metric in metrics + ["wall_s"]:
        cols.append((metric.upper() + "~",
                     (lambda m: lambda k, p: _fmt_num(cell_stat(
                         [r for r in p if excluded_because(r) is None], m)[1]))(metric)))
    cols += [
        ("BIND", lambda k, p: get(p[0], "placement.verdict")),
        ("NOTE", lambda k, p: _group_note(p)),
    ]

    table = [[c[0] for c in cols]]
    for key, pool in groups:
        table.append([fmt(getter(key, pool)) for _name, getter in cols])
    widths = [max(len(r[i]) for r in table) for i in range(len(cols))]
    for i, line in enumerate(table):
        print("  ".join(cell.ljust(widths[j]) for j, cell in enumerate(line)).rstrip())
        if i == 0:
            print("  ".join("-" * w for w in widths).rstrip())
    print()
    print("~ = median across the cell's repeats; N is how many of them are")
    print("comparable.  --per-run lists every run instead.")


def _fmt_num(value):
    if value is None:
        return ""
    return "%g" % value


def _group_note(pool):
    out = [excluded_because(r) for r in pool]
    reasons = sorted({w for w in out if w})
    if reasons and len(reasons) == len(out):
        return "EXCLUDED: " + "; ".join(reasons)
    if reasons:
        return "%d/%d excluded: %s" % (len(reasons), len(out), "; ".join(reasons))
    return ", ".join(get(pool[0], "placement.rules", []) or [])


def print_table(rows, metrics, show_all):
    cols = [
        ("IMAGE", lambda r: get(r, "image.sif", r["_job"])),
        ("APP", lambda r: get(r, "app.name")),
        ("PLACEMENT", lambda r: get(r, "placement.name")),
        ("R/NODE", lambda r: get(r, "placement.ranks_per_node")),
        ("THREADS", lambda r: get(r, "placement.threads")),
        ("REPEAT", lambda r: "%s/%s" % (get(r, "repeat", 1), get(r, "repeats", 1))),
        ("WALL_S", lambda r: get(r, "wall_s")),
    ]
    cols += [(m.upper(), (lambda m: lambda r: get(r, "metrics." + m))(m)) for m in metrics]
    def note(row):
        # Why a row is out, or -- for a row that is still in -- which pathology
        # was tolerated.  A `warn` with nothing shown here would look identical
        # to a clean row.
        why = excluded_because(row)
        if why:
            return "EXCLUDED: " + why
        return ", ".join(get(row, "placement.rules", []) or [])

    cols += [
        ("BIND", lambda r: get(r, "placement.verdict")),
        ("NOTE", note),
    ]

    table = [[c[0] for c in cols]]
    for row in rows:
        table.append([fmt(getter(row)) for _name, getter in cols])

    widths = [max(len(r[i]) for r in table) for i in range(len(cols))]
    for i, line in enumerate(table):
        print("  ".join(cell.ljust(widths[j]) for j, cell in enumerate(line)).rstrip())
        if i == 0:
            print("  ".join("-" * w for w in widths).rstrip())

    if not show_all:
        return
    n_out = sum(1 for r in rows if excluded_because(r))
    cold = [r for r in rows if get(r, "warm", True) is False]
    if n_out or cold:
        print()
    if n_out:
        print("%d row(s) EXCLUDED: never let one win a comparison -- a mis-bound run"
              % n_out)
        print("measures its binding, and an invalid or non-zero-exit run measures nothing.")
    if cold:
        print("%d row(s) warm=false: first cell of a job, so wall_s includes the cold"
              % len(cold))
        print("read of the .sif off GPFS.  Prefer the app's own timer there.")


def print_csv(rows, metrics):
    fields = ["job", "timestamp", "site", "job_id", "nodes",
              "image.sif", "image.digest", "image.compiler", "image.mpi",
              "app.name", "app.version",
              "placement.name", "placement.ranks_per_node", "placement.threads",
              "placement.verdict", "placement.rules",
              "placement.omp.OMP_PROC_BIND", "placement.omp.OMP_PLACES",
              "placement.omp_variant",
              "repeat", "repeats", "warm", "wall_s", "exit", "valid"]
    fields += ["metrics." + m for m in metrics]
    fields += ["comparable", "excluded_because"]

    writer = csv.writer(sys.stdout)
    writer.writerow(fields)
    for row in rows:
        why = excluded_because(row)
        out = []
        for field in fields:
            if field == "job":
                out.append(row["_job"])
            elif field == "comparable":
                out.append(why is None)
            elif field == "excluded_because":
                out.append(why or "")
            elif field == "placement.rules":
                out.append(";".join(get(row, field, []) or []))
            else:
                out.append(get(row, field))
        writer.writerow(out)


def rank_cells(pool, metric, better):
    """Cells of `pool`, best first, by the median of `metric` across repeats."""
    scored = []
    for _key, runs in group_cells(pool):
        low, median = cell_stat(runs, metric)
        if median is not None:
            scored.append((median, low, len(runs), runs[0]))
    return sorted(scored, reverse=better.get(metric, "higher") == "higher")


def print_best(rows, metrics, include_failed=False):
    """The winning cell per app, ranked by what the app said its metric was."""
    usable = rows if include_failed else [r for r in rows if excluded_because(r) is None]
    if not usable:
        print("no comparable rows: every row was excluded (see the table above)")
        return

    for app in sorted({get(r, "app.name", "?") for r in usable}):
        pool = [r for r in usable if get(r, "app.name", "?") == app]
        app_metrics = metric_names(pool)
        primary = next((r["_fom"] for r in pool if r.get("_fom")), None)
        better = {}
        for r in pool:
            better.update(r.get("_better") or {})

        print("app %s -- %d comparable run(s) in %d cell(s)%s" % (
            app or "(none)", len(pool), len(group_cells(pool)),
            "" if primary else "   [no app.yaml alongside: ranking every metric]"))

        # The declared primary first, then any other metric the app reported,
        # then wall_s -- the runner's fallback clock, which belongs last.
        ordered = ([primary] if primary in app_metrics else []) \
                  + [m for m in app_metrics if m != primary]

        for metric in ordered:
            ranked = rank_cells(pool, metric, better)
            if not ranked:
                continue
            median, low, n, win = ranked[0]
            print("  %-5s %-10s %-12s %-28s %s median=%g min=%g (n=%d)%s" % (
                "best" if (primary is None or metric == primary) else "     ",
                metric, get(win, "placement.name"),
                get(win, "image.sif", win["_job"]),
                metric, median, low, n,
                "   [warm=false: includes cold .sif read]"
                if get(win, "warm", True) is False else ""))

        ranked = rank_cells(pool, "wall_s", {"wall_s": "lower"})
        if ranked:
            median, low, n, win = ranked[0]
            print("  %-5s %-10s %-12s %-28s wall_s median=%g min=%g (n=%d)%s" % (
                "" if app_metrics else "best", "wall_s*",
                get(win, "placement.name"), get(win, "image.sif", win["_job"]),
                median, low, n,
                "   [warm=false: includes cold .sif read]"
                if get(win, "warm", True) is False else ""))
            if app_metrics:
                print("        * the runner's clock, not %s's figure of merit: it includes"
                      % (app or "this app"))
                print("          container startup and the app's own setup phase")
        print()


def emit_profile(rows, include_failed=False):
    """The winning cell, as a `profiles:` block for the experiment file.

    This is the point of running a sweep: the answer, in the form you run it
    with (`bench/submit <experiment> --profile production`), rather than a table
    someone retypes into a config by hand and gets one field wrong.
    """
    usable = rows if include_failed else [r for r in rows if excluded_because(r) is None]
    if not usable:
        print("# no comparable rows -- nothing to recommend", file=sys.stderr)
        return 1

    print("# Generated by bench/collect --emit-profile.")
    print("# Paste into the experiment file, then run it with")
    print("#     bench/submit <experiment> --profile production")
    print("profiles:")
    for app in sorted({get(r, "app.name", "?") for r in usable}):
        pool = [r for r in usable if get(r, "app.name", "?") == app]
        primary = next((r["_fom"] for r in pool if r.get("_fom")), None)
        better = {}
        for r in pool:
            better.update(r.get("_better") or {})
        metric = primary if primary in metric_names(pool) else "wall_s"
        ranked = rank_cells(pool, metric,
                            better if metric != "wall_s" else {"wall_s": "lower"})
        if not ranked:
            continue
        median, low, n, win = ranked[0]
        name = "production" if len({get(r, "app.name") for r in usable}) == 1 \
               else "production_%s" % app
        print("  %s:" % name)
        print("    # %s median=%g min=%g over %d run(s)%s"
              % (metric, median, low, n,
                 "   [warm=false: includes the cold .sif read]"
                 if get(win, "warm", True) is False else ""))
        print("    placement: %s" % get(win, "placement.name"))
        omp = get(win, "placement.omp_variant")
        if omp:
            print("    omp: %s" % omp)
        print("    app: %s" % app)
        print("    images: [%s]" % get(win, "image.sif", win["_job"]))
    return 0


def main():
    ap = argparse.ArgumentParser(
        description="Summarise results.jsonl written by the benchmark runner.")
    ap.add_argument("roots", nargs="*", default=[DEFAULT_ROOT],
                    help="results directories or results.jsonl files "
                         "(default: %s)" % DEFAULT_ROOT)
    ap.add_argument("--format", choices=("table", "csv", "json"), default="table")
    ap.add_argument("--best", action="store_true",
                    help="report the winning cell per app, comparable rows only")
    ap.add_argument("--include-failed", action="store_true",
                    help="let excluded rows win in --best; they are always shown "
                         "in the table either way")
    ap.add_argument("--per-run", action="store_true",
                    help="one line per run rather than one per cell; the default "
                         "collapses an experiment's repeats: to their median")
    ap.add_argument("--emit-profile", action="store_true",
                    help="print the winner as a profiles: block for the "
                         "experiment file, and nothing else")
    args = ap.parse_args()

    roots = args.roots or [DEFAULT_ROOT]
    paths = find_result_files(roots)
    if not paths:
        print("no results.jsonl under: %s" % ", ".join(roots), file=sys.stderr)
        print("  (jobs write one per results directory; have they finished?)",
              file=sys.stderr)
        return 1

    rows, damaged = load_rows(paths)
    if damaged:
        print("skipped %d unparseable line(s) -- a job killed mid-write leaves a "
              "partial last row:" % len(damaged), file=sys.stderr)
        for where in damaged:
            print("  %s" % where, file=sys.stderr)
    if not rows:
        print("no rows in: %s" % ", ".join(paths), file=sys.stderr)
        return 1

    rows.sort(key=lambda r: (get(r, "app.name"), r["_job"],
                             get(r, "placement.name"), get(r, "repeat", 0)))
    metrics = metric_names(rows)

    if args.emit_profile:
        return emit_profile(rows, include_failed=args.include_failed)

    if args.format == "json":
        json.dump(rows, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
    elif args.format == "csv":
        print_csv(rows, metrics)
    elif args.per_run or not repeated(rows):
        print_table(rows, metrics, show_all=True)
    else:
        print_grouped_table(rows, metrics)

    if args.best:
        print()
        print_best(rows, metrics, include_failed=args.include_failed)
    return 0


if __name__ == "__main__":
    sys.exit(main())
