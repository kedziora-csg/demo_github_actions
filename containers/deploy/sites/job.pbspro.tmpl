#!/bin/bash
#PBS -N @JOB_NAME@
#PBS -A @ACCOUNT@
#PBS -j oe
#PBS -q @QUEUE@
#PBS -l walltime=@WALLTIME@
#PBS -l select=@NODES@:ncpus=@NCPUS@:mpiprocs=@MPIPROCS@:ompthreads=1
#PBS -o @RESULTS_DIR@/job.log

#-------------------------------------------------------------------------------
# GENERATED by bench/submit from
#     @EXPERIMENT@
# Do not edit: bench/submit overwrites this file on the next submission.  Edit
# the experiment, or copy this script somewhere else and qsub the copy.
#
# The skeleton is sites/job.pbspro.tmpl -- shared by every PBS Pro site, because
# the directive block is the same on all of them and the parts that are not
# (queue, node count, walltime) are substituted.  A site that genuinely needs
# different directives puts its own sites/<site>/job.tmpl beside its profile,
# and that wins.
#
# It is kept beside the results on purpose.  A directive cannot be
# parameterised inside a PBS file -- `#PBS -l select=` is a comment to the shell
# and a directive to PBS, with nothing expanding a variable in between -- so the
# alternative was overriding directives on the qsub line and passing the rest
# through `-v`, which left no record of what was actually requested.  This file
# IS that record.
#
# Everything it does:
#   1. source the site profile named at submission time,
#   2. bring up the module environment,
#   3. point the runner at this job's expanded configuration and hand over.
#
# The sweep itself is in bench/runner.sh, which is site- and app-agnostic and is
# the same code the hand-qsub path (PBS/App_benchmarker_derecho.pbs) runs.
#-------------------------------------------------------------------------------
set -u

# Named outright rather than searched for: a job generated from one checkout
# must be driven by that checkout's profile, even if the operator also has a
# ~/.config/hpcdev/site.sh pointing somewhere else.
. "@SITE_CONF@" || { echo "cannot source @SITE_CONF@" >&2; exit 1; }
bench_site_modules || { echo "site module bootstrap failed" >&2; exit 1; }

# Exported, not just sourced: the next line is an exec, and while exported
# VARIABLES cross an exec, shell FUNCTIONS do not.  The runner re-sources this
# file to recover bench_site_modules and the bench_site_* lookups, and naming it
# here is what makes it re-source the SAME profile this job was submitted with.
export BENCH_SITE_CONF="@SITE_CONF@"

export BENCH_JOB_ENV="@JOB_ENV@"
exec "@BENCH_ROOT@/runner.sh"
